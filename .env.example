# Motet v1 runtime secrets & configuration
# Copy to ~/.config/motet/env (chmod 600 ~/.config/motet/env) on your exe.dev VM.
# After editing on motet.exe.xyz, reload the services:
#   sudo systemctl restart motet-server motet-watch
#
# Recommended: set MOTET_MASTER_KEY below, then store/rotate all provider & app
# keys right in Motet's write-only AES-256-GCM Vault (`motet vault set` or
# Dashboard -> Vault & Secrets). Vault secrets take precedence over Env vars.

# ------------------------------------------------------------------------------
# Master Encryption Key for Motet's AES-256-GCM Vault & OAuth tokens
# Generate a 32-byte hex key with: openssl rand -hex 32
# ------------------------------------------------------------------------------
# MOTET_MASTER_KEY=replace-with-64-hex-char-master-key

# ------------------------------------------------------------------------------
# Anthropic Messages API (default for chief, work, personal; native prompt caching)
#   Endpoint: https://api.anthropic.com/v1/messages
#   Models:   claude-sonnet-5-5 (smart), claude-opus-5-5 (opus), claude-haiku-5-5 (fast)
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# ------------------------------------------------------------------------------
# Google Gemini (native generateContent API; default for finance & researcher)
#   Endpoint: https://generativelanguage.googleapis.com/v1beta/models
#   Models:   gemini-2.5-flash (gemini_flash), gemini-2.5-pro (gemini_pro),
#             gemini-2.5-flash-lite (gemini_lite)
#   Key from: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy-your-google-gemini-key-here

# ------------------------------------------------------------------------------
# Optional OpenAI-compatible providers
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ------------------------------------------------------------------------------
# Web Search (Anthropic native web_search also works via ANTHROPIC_API_KEY)
# Cascade order: TAVILY_API_KEY -> BRAVE_API_KEY -> EXA_API_KEY -> ANTHROPIC_API_KEY
# ------------------------------------------------------------------------------
# TAVILY_API_KEY=tvly-your-tavily-key-here
# BRAVE_API_KEY=BSA-your-brave-search-key-here
# EXA_API_KEY=your-exa-api-key-here

# ------------------------------------------------------------------------------
# Everyday App & Sidecar Connectors (can also be sealed in Vault)
# ------------------------------------------------------------------------------
# TODOIST_API_TOKEN=your-todoist-token
# HEARTH_API_TOKEN=your-hearth-arvo-scoped-token
# NOTION_TOKEN=ntn_your-notion-token
# TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token

# ------------------------------------------------------------------------------
# Dormant Engineering Connector (T3 Code — re-enable when ready)
# ------------------------------------------------------------------------------
# T3_MCP_URL=http://127.0.0.1:3773/mcp
# T3_MCP_TOKEN=your-t3-mcp-bearer-token

# ------------------------------------------------------------------------------
# Optional API Bearer token for /v1/* and /mcp
# (Leave commented while motet.exe.xyz is in exe.dev Private mode; set before
#  exposing publicly or calling from external scripts / native Mac & iOS apps.)
# ------------------------------------------------------------------------------
# MOTET_API_TOKEN=replace-with-random-secret-token
