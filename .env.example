# Motet runtime secrets & configuration
# Copy to ~/.config/motet/env (chmod 600 ~/.config/motet/env) on your server.
# After editing on motet.exe.xyz, reload the services:
#   sudo systemctl restart motet-server motet-watch
#
# Secrets stay strictly in this outer env file (never in SQLite, memory, or
# confined Command sandboxes). Each bot references an env var NAME in `api_key_env`.

# ------------------------------------------------------------------------------
# Anthropic Messages API (native tool_use + explicit prompt cache breakpoints)
#   Bot Studio -> Provider: Anthropic
#   Endpoint: https://api.anthropic.com/v1/messages
#   Models:   claude-sonnet-4-6 (smart), claude-opus-4-6 (frontier), claude-haiku-4-5 (fast)
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# ------------------------------------------------------------------------------
# Google Gemini (via official OpenAI-compatible Chat Completions endpoint)
#   Bot Studio -> Provider: Google Gemini
#   Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   Models:   gemini-2.5-flash (fast), gemini-2.5-pro (smart), gemini-3.8-flash
#   Key from: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy-your-google-gemini-key-here

# ------------------------------------------------------------------------------
# xAI / Grok (OpenAI-compatible; default for seeded `chief` and `watcher` bots)
#   Endpoint: https://api.x.ai/v1/chat/completions
#   Models:   grok-4 (smart), grok-4-fast (fast)
# ------------------------------------------------------------------------------
# XAI_API_KEY=xai-your-xai-key-here

# ------------------------------------------------------------------------------
# OpenAI (OpenAI-compatible)
#   Endpoint: https://api.openai.com/v1/chat/completions
#   Models:   gpt-4.1 (smart), gpt-4.1-mini (fast)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your-openai-key-here

# ------------------------------------------------------------------------------
# OpenRouter (OpenAI-compatible multi-provider router)
#   Endpoint: https://openrouter.ai/api/v1/chat/completions
#   Models:   anthropic/claude-sonnet-4-6, google/gemini-2.5-pro, x-ai/grok-4
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ------------------------------------------------------------------------------
# T3 Code MCP Connector (Connector #1)
# ------------------------------------------------------------------------------
# T3_MCP_URL=http://127.0.0.1:3773/mcp
# T3_MCP_TOKEN=your-t3-mcp-bearer-token

# ------------------------------------------------------------------------------
# Optional future HTTP MCP connector tokens (referenced by connector `auth_env`)
# ------------------------------------------------------------------------------
# NOTION_TOKEN=ntn_your-notion-token
# LINEAR_TOKEN=lin_api_your-linear-token
# GITHUB_TOKEN=ghp_your-github-token
# SLACK_TOKEN=xoxb-your-slack-token

# ------------------------------------------------------------------------------
# Optional API Bearer token for /v1/* and /mcp
# (Leave commented while motet.exe.xyz is in exe.dev Private mode; set before
#  exposing publicly or calling from external scripts / native Mac & iOS apps.)
# ------------------------------------------------------------------------------
# MOTET_API_TOKEN=replace-with-random-secret-token
