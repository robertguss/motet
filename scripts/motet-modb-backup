#!/usr/bin/env bash
set -euo pipefail
umask 077

# Hourly encrypted CoW-incremental backup, restore verification, Telegram failure alerting,
# and fail-closed off-host ciphertext replication for Motet (`motet.modb` + `motet-secrets.modb`).

STATE_DIR="${MOTET_STATE_DIR:-$HOME/.local/share/motet}"
ENV_FILE="${MOTET_ENV_FILE:-$HOME/.config/motet/env}"
PEER_ID="${MODB_BACKUP_PEER_ID:-auto-backup}"
KEY_ID="${MODB_BACKUP_KEY_ID:-motet-auto-v1}"
AAD="${MODB_BACKUP_AAD:-motet-auto-backup}"
SECRETS_AAD="${MODB_BACKUP_SECRETS_AAD:-motet-secrets-auto}"
RETENTION_GENS="${MODB_BACKUP_RETENTION_GENS:-4}"
MAX_DELTAS_PER_GEN="${MODB_BACKUP_MAX_DELTAS:-168}"
MAX_GEN_AGE_SEC="${MODB_BACKUP_MAX_GEN_AGE_SEC:-604800}"
VERIFY_EVERY_N="${MODB_BACKUP_VERIFY_EVERY_N:-6}"
MOTET_BIN="${MOTET_BIN:-$(command -v motet || echo "$HOME/.local/bin/motet")}"
MODB_BIN="${MODB_BIN:-$(command -v modb || echo "$HOME/.local/bin/modb")}"

FORCE_ROTATE=0
FORCE_VERIFY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --rotate)
      FORCE_ROTATE=1
      shift
      ;;
    --verify-restore)
      FORCE_VERIFY=1
      shift
      ;;
    --peer)
      PEER_ID="${2:?--peer requires an argument}"
      shift 2
      ;;
    *)
      echo "usage: $0 [--rotate] [--verify-restore] [--peer <id>]" >&2
      exit 2
      ;;
  esac
done

load_env_var_if_unset() {
  local var_name="$1"
  local current_val="${!var_name:-}"
  if [ -n "$current_val" ] || [ ! -r "$ENV_FILE" ]; then
    return 0
  fi
  local raw_line=""
  raw_line="$(grep -E "^(export[[:space:]]+)?${var_name}=" "$ENV_FILE" | tail -n 1 || true)"
  if [ -n "$raw_line" ]; then
    local val="${raw_line#*=}"
    val="${val%\"}"
    val="${val#\"}"
    val="${val%\'}"
    val="${val#\'}"
    export "${var_name}=${val}"
  fi
}

load_env_var_if_unset MODB_BACKUP_KEY_HEX
load_env_var_if_unset MODB_BACKUP_KEYRING
load_env_var_if_unset MODB_BACKUP_KEY_ID
load_env_var_if_unset MODB_BACKUP_AAD
load_env_var_if_unset MODB_BACKUP_SECRETS_AAD
load_env_var_if_unset MODB_BACKUP_GIT_REMOTE
load_env_var_if_unset MODB_BACKUP_RSYNC_DEST
load_env_var_if_unset TELEGRAM_BOT_TOKEN
load_env_var_if_unset TELEGRAM_ALLOWED_USER_ID

# Re-evaluate overridable settings if loaded from ENV_FILE above.
KEY_ID="${MODB_BACKUP_KEY_ID:-$KEY_ID}"
AAD="${MODB_BACKUP_AAD:-$AAD}"
SECRETS_AAD="${MODB_BACKUP_SECRETS_AAD:-$SECRETS_AAD}"

BACKUP_ROOT="backups/encrypted"
ABS_BACKUP_ROOT="$STATE_DIR/$BACKUP_ROOT"
mkdir -p "$ABS_BACKUP_ROOT"
chmod 700 "$ABS_BACKUP_ROOT"

CUR_GEN=""
ACKED_SEQ=0
ACKED_TXID=0
LAST_OPS=0
SECRETS_BACKED_UP=0
SECRETS_VERIFIED=0
SECRETS_ENTRIES=0
OFFHOST_MODE="local-only"
OFFHOST_TARGET="local disk only"
OFFHOST_OK=0
OFFHOST_PUSHED_AT=""
LAST_ERR_STAGE="init"

TMP_RESTORE_REL=""
TMP_SECRETS_REL=""
cleanup() {
  if [ -n "$TMP_RESTORE_REL" ]; then
    rm -f "$STATE_DIR/$TMP_RESTORE_REL" "$STATE_DIR/${TMP_RESTORE_REL}.sync-restore.tmp" 2>/dev/null || true
  fi
  if [ -n "$TMP_SECRETS_REL" ]; then
    rm -f "$STATE_DIR/$TMP_SECRETS_REL" "$STATE_DIR/${TMP_SECRETS_REL}.sync-restore.tmp" 2>/dev/null || true
  fi
  rm -f "$ABS_BACKUP_ROOT/.delta.tmp.json" 2>/dev/null || true
}
trap cleanup EXIT

write_error_status() {
  local err_msg="$1"
  python3 - "$ABS_BACKUP_ROOT" "$CUR_GEN" "$PEER_ID" "$KEY_ID" "$AAD" "$SECRETS_AAD" "$OFFHOST_MODE" "$OFFHOST_TARGET" "$err_msg" <<'PY' || true
import datetime, json, os, sys
abs_root, cur_gen, peer_id, key_id, aad, sec_aad, off_mode, off_target, err_msg = sys.argv[1:10]
status_path = os.path.join(abs_root, "status.json")
prev = {}
if os.path.exists(status_path):
    try:
        with open(status_path, "r", encoding="utf-8") as fh:
            prev = json.load(fh)
    except Exception:
        prev = {}
now_iso = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
status = dict(prev)
status.update({
    "last_run_at": now_iso,
    "peer_id": peer_id,
    "generation": cur_gen or prev.get("generation", ""),
    "action": "error",
    "encrypted": True,
    "key_id": key_id,
    "aad": aad,
    "secrets_aad": sec_aad,
    "offhost_mode": off_mode,
    "offhost_target": off_target,
    "offhost_ok": False,
    "verified_this_run": False,
    "last_error": err_msg,
})
tmp = status_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(status, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, status_path)
PY
}

on_err() {
  local rc="$1"
  local lineno="$2"
  trap - ERR
  local msg="step='${LAST_ERR_STAGE}' exit=${rc} line=${lineno}"
  echo "[motet-modb-backup] ERROR: $msg" >&2
  write_error_status "$msg"
  if [ -x "$MOTET_BIN" ]; then
    (cd "$STATE_DIR" 2>/dev/null && "$MOTET_BIN" alert "[Motet Backup Alert] motet-modb-backup failed on $(hostname -s): ${msg}") >/dev/null 2>&1 || true
  fi
  exit "$rc"
}
trap 'on_err $? $LINENO' ERR

LAST_ERR_STAGE="preflight"
if [ -z "${MODB_BACKUP_KEY_HEX:-}" ]; then
  echo "[motet-modb-backup] ERROR: MODB_BACKUP_KEY_HEX is unset (check $ENV_FILE)" >&2
  exit 1
fi
if [ ! -x "$MOTET_BIN" ]; then
  echo "[motet-modb-backup] ERROR: motet binary not found/executable at $MOTET_BIN" >&2
  exit 1
fi
if [ ! -x "$MODB_BIN" ]; then
  echo "[motet-modb-backup] ERROR: modb binary not found/executable at $MODB_BIN" >&2
  exit 1
fi
if [ ! -f "$STATE_DIR/motet.modb" ]; then
  echo "[motet-modb-backup] ERROR: live database not found at $STATE_DIR/motet.modb" >&2
  exit 1
fi

LOCK_FILE="$ABS_BACKUP_ROOT/.backup.lock"
exec 9>"$LOCK_FILE"
if ! flock -w 30 9; then
  echo "[motet-modb-backup] ERROR: timed out waiting for backup lock $LOCK_FILE" >&2
  exit 1
fi

cd "$STATE_DIR"

LAST_ERR_STAGE="check_peers"
PEERS_JSON="$("$MOTET_BIN" sync peers --json)"
PEER_INFO="$(
  python3 - "$PEER_ID" "$PEERS_JSON" <<'PY'
import json, sys
pid = sys.argv[1]
peers = json.loads(sys.argv[2])
match = next((p for p in peers if p.get("peer_id") == pid), None)
if match is None:
    print("0\t0\t0")
else:
    print(f"1\t{int(match.get('acked_seq', 0))}\t{int(match.get('acked_txid', 0))}")
PY
)"
IFS=$'\t' read -r PEER_EXISTS ACKED_SEQ ACKED_TXID <<< "$PEER_INFO"

if [ -r "$ABS_BACKUP_ROOT/current.txt" ]; then
  CUR_GEN="$(tr -d '[:space:]' < "$ABS_BACKUP_ROOT/current.txt")"
fi

GEN_AGE_EXCEEDED=0
if [ -n "$CUR_GEN" ] && [ -r "$ABS_BACKUP_ROOT/$CUR_GEN/meta.json" ]; then
  GEN_AGE_EXCEEDED="$(
    python3 - "$ABS_BACKUP_ROOT/$CUR_GEN/meta.json" "$MAX_GEN_AGE_SEC" <<'PY'
import json, sys, time
with open(sys.argv[1], "r", encoding="utf-8") as fh:
    meta = json.load(fh)
created_epoch = int(meta.get("created_epoch", 0))
max_age = int(sys.argv[2])
print("1" if created_epoch > 0 and (int(time.time()) - created_epoch) >= max_age else "0")
PY
  )"
fi

NEED_NEW_GEN=0
if [ "$FORCE_ROTATE" -eq 1 ] || [ "$PEER_EXISTS" -ne 1 ] || [ -z "$CUR_GEN" ] || [ ! -f "$ABS_BACKUP_ROOT/$CUR_GEN/base.enc.json" ]; then
  NEED_NEW_GEN=1
elif [ "$ACKED_SEQ" -ge "$MAX_DELTAS_PER_GEN" ] || [ "$GEN_AGE_EXCEEDED" -eq 1 ]; then
  NEED_NEW_GEN=1
fi

ACTION=""
SHOULD_VERIFY=0

if [ "$NEED_NEW_GEN" -eq 1 ]; then
  LAST_ERR_STAGE="new_generation"
  TS_SLUG="$(date -u +%Y%m%dT%H%M%SZ)"
  GEN_NAME="gen-$TS_SLUG"
  SUF=1
  while [ -e "$ABS_BACKUP_ROOT/$GEN_NAME" ]; do
    GEN_NAME="gen-${TS_SLUG}-${SUF}"
    SUF=$((SUF + 1))
  done
  mkdir -p "$ABS_BACKUP_ROOT/$GEN_NAME"
  chmod 700 "$ABS_BACKUP_ROOT/$GEN_NAME"

  if [ "$PEER_EXISTS" -eq 1 ]; then
    "$MOTET_BIN" sync remove-peer "$PEER_ID" >/dev/null
  fi
  INIT_JSON="$("$MOTET_BIN" sync init-peer "$PEER_ID" --include-internal --json)"
  ACKED_TXID="$(
    python3 - "$INIT_JSON" <<'PY'
import json, sys
print(int(json.loads(sys.argv[1]).get("acked_txid", 0)))
PY
  )"
  ACKED_SEQ=0

  REL_BASE="$BACKUP_ROOT/$GEN_NAME/base.enc.json"
  "$MOTET_BIN" sync base-snapshot "$PEER_ID" "$REL_BASE" --encrypt --key-id "$KEY_ID" --aad "$AAD" >/dev/null
  chmod 600 "$STATE_DIR/$REL_BASE"

  python3 - "$ABS_BACKUP_ROOT/$GEN_NAME/meta.json" "$PEER_ID" "$KEY_ID" "$AAD" "$SECRETS_AAD" "$ACKED_TXID" <<'PY'
import datetime, json, os, sys, time
out_path, pid, key_id, aad, sec_aad, txid = sys.argv[1:7]
meta = {
    "peer_id": pid,
    "key_id": key_id,
    "aad": aad,
    "secrets_aad": sec_aad,
    "base_file": "base.enc.json",
    "base_txid": int(txid),
    "created_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "created_epoch": int(time.time()),
}
tmp = out_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(meta, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, out_path)
PY

  printf '%s\n' "$GEN_NAME" > "$ABS_BACKUP_ROOT/current.txt.tmp"
  chmod 600 "$ABS_BACKUP_ROOT/current.txt.tmp"
  mv "$ABS_BACKUP_ROOT/current.txt.tmp" "$ABS_BACKUP_ROOT/current.txt"
  CUR_GEN="$GEN_NAME"
  ACTION="new_generation"
  SHOULD_VERIFY=1

  # Prune old generations past RETENTION_GENS (keep newest N).
  python3 - "$ABS_BACKUP_ROOT" "$RETENTION_GENS" "$CUR_GEN" <<'PY'
import os, shutil, sys
root, keep_s, cur = sys.argv[1], int(sys.argv[2]), sys.argv[3]
gens = sorted([
    d for d in os.listdir(root)
    if d.startswith("gen-") and os.path.isdir(os.path.join(root, d))
])
if len(gens) > keep_s:
    to_drop = gens[:len(gens) - keep_s]
    for g in to_drop:
        if g != cur:
            shutil.rmtree(os.path.join(root, g), ignore_errors=True)
PY
else
  LAST_ERR_STAGE="export_delta"
  REL_TMP_DELTA="$BACKUP_ROOT/.delta.tmp.json"
  rm -f "$STATE_DIR/$REL_TMP_DELTA"
  EXPORT_JSON="$("$MOTET_BIN" sync export "$PEER_ID" "$REL_TMP_DELTA" --encrypt --key-id "$KEY_ID" --aad "$AAD" --json)"
  read -r EXP_SEQ EXP_OPS EXP_HASH <<< "$(
    python3 - "$EXPORT_JSON" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
print(f"{int(d['seq'])} {int(d['ops'])} {d['delta_hash']}")
PY
  )"
  LAST_OPS="$EXP_OPS"
  if [ "$EXP_OPS" -eq 0 ]; then
    rm -f "$STATE_DIR/$REL_TMP_DELTA"
    ACTION="noop"
  else
    DELTA_FILE="$(printf '%06d.delta.enc.json' "$EXP_SEQ")"
    mv "$STATE_DIR/$REL_TMP_DELTA" "$ABS_BACKUP_ROOT/$CUR_GEN/$DELTA_FILE"
    chmod 600 "$ABS_BACKUP_ROOT/$CUR_GEN/$DELTA_FILE"
    ACK_JSON="$("$MOTET_BIN" sync ack "$PEER_ID" --seq "$EXP_SEQ" --hash "$EXP_HASH" --json)"
    read -r ACKED_SEQ ACKED_TXID <<< "$(
      python3 - "$ACK_JSON" <<'PY'
import json, sys
p = json.loads(sys.argv[1])
print(f"{int(p['acked_seq'])} {int(p['acked_txid'])}")
PY
    )"
    ACTION="delta_exported"
    if [ "$VERIFY_EVERY_N" -gt 0 ] && [ $((EXP_SEQ % VERIFY_EVERY_N)) -eq 0 ]; then
      SHOULD_VERIFY=1
    fi
  fi
fi

# Back up isolated motet-secrets.modb whenever missing in current generation or changed on disk.
LAST_ERR_STAGE="secrets_snapshot"
REL_SECRETS="$BACKUP_ROOT/$CUR_GEN/secrets.enc.json"
ABS_SECRETS_SNAP="$STATE_DIR/$REL_SECRETS"
if [ -f "$STATE_DIR/motet-secrets.modb" ]; then
  SECRETS_SHA256="$(sha256sum "$STATE_DIR/motet-secrets.modb" | awk '{print $1}')"
  PREV_SECRETS_INFO="$(
    python3 - "$ABS_BACKUP_ROOT/$CUR_GEN/meta.json" <<'PY'
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        m = json.load(fh)
    print(f"{m.get('secrets_sha256', '')}\t{int(m.get('secrets_entries', 0))}")
except Exception:
    print("\t0")
PY
  )"
  IFS=$'\t' read -r STORED_SEC_SHA SECRETS_ENTRIES <<< "$PREV_SECRETS_INFO"
  if [ ! -f "$ABS_SECRETS_SNAP" ] || [ "$SECRETS_SHA256" != "$STORED_SEC_SHA" ]; then
    SEC_OUT_JSON="$("$MOTET_BIN" sync secrets-snapshot "$REL_SECRETS" --encrypt --key-id "$KEY_ID" --aad "$SECRETS_AAD" --json)"
    chmod 600 "$ABS_SECRETS_SNAP"
    SECRETS_ENTRIES="$(
      python3 - "$SEC_OUT_JSON" <<'PY'
import json, sys
print(int(json.loads(sys.argv[1]).get("entries", 0)))
PY
    )"
    python3 - "$ABS_BACKUP_ROOT/$CUR_GEN/meta.json" "$SECRETS_SHA256" "$SECRETS_ENTRIES" "$SECRETS_AAD" <<'PY'
import datetime, json, os, sys
meta_path, sec_sha, sec_entries_s, sec_aad = sys.argv[1:5]
with open(meta_path, "r", encoding="utf-8") as fh:
    meta = json.load(fh)
meta["secrets_file"] = "secrets.enc.json"
meta["secrets_sha256"] = sec_sha
meta["secrets_entries"] = int(sec_entries_s)
meta["secrets_aad"] = sec_aad
meta["secrets_updated_at"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
tmp = meta_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(meta, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, meta_path)
PY
    SHOULD_VERIFY=1
  fi
  SECRETS_BACKED_UP=1
fi

if [ "$FORCE_VERIFY" -eq 1 ]; then
  SHOULD_VERIFY=1
fi

VERIFIED_RESTORE=0
VERIFIED_TXID=0
VERIFIED_AUDIT=0
if [ "$SHOULD_VERIFY" -eq 1 ]; then
  LAST_ERR_STAGE="verify_restore"
  TMP_RESTORE_REL="$BACKUP_ROOT/.verify-${CUR_GEN}.modb"
  rm -f "$STATE_DIR/$TMP_RESTORE_REL" "$STATE_DIR/${TMP_RESTORE_REL}.sync-restore.tmp"
  REL_BASE="$BACKUP_ROOT/$CUR_GEN/base.enc.json"
  REL_DELTAS=()
  while IFS= read -r df; do
    [ -n "$df" ] && REL_DELTAS+=("$BACKUP_ROOT/$CUR_GEN/$(basename "$df")")
  done < <(find "$ABS_BACKUP_ROOT/$CUR_GEN" -maxdepth 1 -name '*.delta.enc.json' | LC_ALL=C sort)

  RESTORE_JSON="$("$MOTET_BIN" sync restore "$TMP_RESTORE_REL" --base "$REL_BASE" ${REL_DELTAS[@]+"${REL_DELTAS[@]}"} --decrypt --aad "$AAD" --json)"
  VERIFY_JSON="$("$MODB_BIN" verify "$TMP_RESTORE_REL" --json)"
  rm -f "$STATE_DIR/$TMP_RESTORE_REL" "$STATE_DIR/${TMP_RESTORE_REL}.sync-restore.tmp"
  TMP_RESTORE_REL=""

  read -r VERIFIED_RESTORE VERIFIED_TXID VERIFIED_AUDIT <<< "$(
    python3 - "$RESTORE_JSON" "$VERIFY_JSON" <<'PY'
import json, sys
r = json.loads(sys.argv[1])
v = json.loads(sys.argv[2])
ok = bool(v.get("ok?", False)) and int(v.get("txid", 0)) == int(r.get("final_txid", -1))
if not ok:
    sys.stderr.write(f"verify mismatch: restore={r} verify={v}\n")
    sys.exit(1)
print(f"1 {int(v.get('txid', 0))} {int(v.get('audit_entries', 0))}")
PY
  )"

  if [ -f "$ABS_SECRETS_SNAP" ]; then
    LAST_ERR_STAGE="verify_restore_secrets"
    TMP_SECRETS_REL="$BACKUP_ROOT/.verify-${CUR_GEN}-secrets.modb"
    rm -f "$STATE_DIR/$TMP_SECRETS_REL" "$STATE_DIR/${TMP_SECRETS_REL}.sync-restore.tmp"
    SEC_REST_JSON="$("$MOTET_BIN" sync restore-secrets "$TMP_SECRETS_REL" "$REL_SECRETS" --decrypt --aad "$SECRETS_AAD" --json)"
    python3 - "$SEC_REST_JSON" <<'PY'
import json, sys
r = json.loads(sys.argv[1])
if int(r.get("final_txid", 0)) < 1:
    sys.stderr.write(f"unexpected restored secrets final_txid: {r}\n")
    sys.exit(1)
PY
    rm -f "$STATE_DIR/$TMP_SECRETS_REL" "$STATE_DIR/${TMP_SECRETS_REL}.sync-restore.tmp"
    TMP_SECRETS_REL=""
    SECRETS_VERIFIED=1
  fi
fi

# Fail-closed ciphertext assertion + off-host replication (Git / Rsync).
if [ -n "${MODB_BACKUP_GIT_REMOTE:-}" ] || [ -d "$ABS_BACKUP_ROOT/.git" ]; then
  LAST_ERR_STAGE="offhost_git_verify"
  python3 - "$ABS_BACKUP_ROOT" <<'PY'
import glob, json, os, sys
root = sys.argv[1]
enc_files = sorted(glob.glob(os.path.join(root, "gen-*", "*.enc.json")))
if not enc_files:
    sys.stderr.write("no encrypted *.enc.json artifacts found under generations\n")
    sys.exit(1)
for fp in enc_files:
    with open(fp, "r", encoding="utf-8") as fh:
        obj = json.load(fh)
    if (
        not isinstance(obj, dict)
        or obj.get("format_version") != 1
        or obj.get("alg") != "AES-256-GCM"
        or obj.get("kind") not in ("snapshot", "delta")
        or not obj.get("nonce_b64")
        or not obj.get("ciphertext_b64")
        or "buckets" in obj
        or "payload_hash" in obj
        or "sha256" in obj
    ):
        sys.stderr.write(f"refusing unsealed or malformed backup file before push: {fp}\n")
        sys.exit(1)
PY

  LAST_ERR_STAGE="offhost_git_push"
  cat > "$ABS_BACKUP_ROOT/.gitignore.tmp" <<'EOF'
status.json
status.json.tmp
.backup.lock
.verify-*
.delta.tmp.json
*.tmp
*.modb
*.modb.*
EOF
  chmod 600 "$ABS_BACKUP_ROOT/.gitignore.tmp"
  mv "$ABS_BACKUP_ROOT/.gitignore.tmp" "$ABS_BACKUP_ROOT/.gitignore"

  if [ ! -d "$ABS_BACKUP_ROOT/.git" ]; then
    git -C "$ABS_BACKUP_ROOT" init -b main >/dev/null
    git -C "$ABS_BACKUP_ROOT" config user.name "Motet Backup"
    git -C "$ABS_BACKUP_ROOT" config user.email "motet-backup@local"
  fi
  REMOTE_URL="${MODB_BACKUP_GIT_REMOTE:-}"
  if [ -n "$REMOTE_URL" ]; then
    if git -C "$ABS_BACKUP_ROOT" remote get-url origin >/dev/null 2>&1; then
      CUR_REMOTE="$(git -C "$ABS_BACKUP_ROOT" remote get-url origin)"
      if [ "$CUR_REMOTE" != "$REMOTE_URL" ]; then
        git -C "$ABS_BACKUP_ROOT" remote set-url origin "$REMOTE_URL"
      fi
    else
      git -C "$ABS_BACKUP_ROOT" remote add origin "$REMOTE_URL"
    fi
  else
    REMOTE_URL="$(git -C "$ABS_BACKUP_ROOT" remote get-url origin 2>/dev/null || echo "")"
  fi

  git -C "$ABS_BACKUP_ROOT" add -A -- .gitignore current.txt gen-*
  PUSH_RAN=0
  if ! git -C "$ABS_BACKUP_ROOT" diff --cached --quiet; then
    git -C "$ABS_BACKUP_ROOT" commit -m "backup: ${CUR_GEN} seq=${ACKED_SEQ} tx=${ACKED_TXID}" >/dev/null
    git -C "$ABS_BACKUP_ROOT" push -u origin main >/dev/null 2>&1
    PUSH_RAN=1
  elif git -C "$ABS_BACKUP_ROOT" rev-parse --verify origin/main >/dev/null 2>&1; then
    AHEAD_CNT="$(git -C "$ABS_BACKUP_ROOT" rev-list --count origin/main..HEAD)"
    if [ "$AHEAD_CNT" -gt 0 ]; then
      git -C "$ABS_BACKUP_ROOT" push origin main >/dev/null 2>&1
      PUSH_RAN=1
    fi
  else
    git -C "$ABS_BACKUP_ROOT" push -u origin main >/dev/null 2>&1
    PUSH_RAN=1
  fi

  OFFHOST_MODE="git"
  # Strip any embedded credentials if user ever configures https URL with userinfo.
  OFFHOST_TARGET="$(
    python3 - "$REMOTE_URL" <<'PY'
import re, sys
u = sys.argv[1].strip()
u = re.sub(r'://[^/@]+@', '://***@', u)
u = re.sub(r'^git@', '', u)
print(u or "origin")
PY
  )"
  OFFHOST_OK=1
  if [ "$PUSH_RAN" -eq 1 ]; then
    OFFHOST_PUSHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fi
elif [ -n "${MODB_BACKUP_RSYNC_DEST:-}" ]; then
  LAST_ERR_STAGE="offhost_rsync"
  rsync -az --delete \
    --exclude 'status.json' \
    --exclude 'status.json.tmp' \
    --exclude '.backup.lock' \
    --exclude '.verify-*' \
    --exclude '.delta.tmp.json' \
    --exclude '*.tmp' \
    --exclude '*.modb' \
    --exclude '*.modb.*' \
    "$ABS_BACKUP_ROOT/" "$MODB_BACKUP_RSYNC_DEST/" >/dev/null
  OFFHOST_MODE="rsync"
  OFFHOST_TARGET="$MODB_BACKUP_RSYNC_DEST"
  OFFHOST_OK=1
  OFFHOST_PUSHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
fi

LAST_ERR_STAGE="write_status"
python3 - "$ABS_BACKUP_ROOT" "$CUR_GEN" "$PEER_ID" "$KEY_ID" "$AAD" "$SECRETS_AAD" "$ACTION" "$ACKED_SEQ" "$ACKED_TXID" "$LAST_OPS" "$VERIFIED_RESTORE" "$VERIFIED_TXID" "$VERIFIED_AUDIT" "$SECRETS_BACKED_UP" "$SECRETS_VERIFIED" "$SECRETS_ENTRIES" "$OFFHOST_MODE" "$OFFHOST_TARGET" "$OFFHOST_OK" "$OFFHOST_PUSHED_AT" <<'PY'
import datetime, json, os, sys
(
    abs_root, cur_gen, peer_id, key_id, aad, sec_aad, action,
    acked_seq_s, acked_txid_s, last_ops_s,
    ver_ok_s, ver_tx_s, ver_audit_s,
    sec_up_s, sec_ver_s, sec_ent_s,
    off_mode, off_target, off_ok_s, off_pushed_at
) = sys.argv[1:21]
gen_dir = os.path.join(abs_root, cur_gen)
deltas = sorted(f for f in os.listdir(gen_dir) if f.endswith(".delta.enc.json"))
gens = sorted(d for d in os.listdir(abs_root) if d.startswith("gen-") and os.path.isdir(os.path.join(abs_root, d)))
prev = {}
status_path = os.path.join(abs_root, "status.json")
if os.path.exists(status_path):
    try:
        with open(status_path, "r", encoding="utf-8") as fh:
            prev = json.load(fh)
    except Exception:
        prev = {}
now_iso = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
ver_ok = ver_ok_s == "1"
sec_up = sec_up_s == "1"
sec_ver = (sec_ver_s == "1") or (sec_up and bool(prev.get("secrets_verified", False)) and prev.get("generation") == cur_gen)
off_ok = off_ok_s == "1"
status = {
    "last_run_at": now_iso,
    "peer_id": peer_id,
    "generation": cur_gen,
    "action": action,
    "acked_seq": int(acked_seq_s),
    "acked_txid": int(acked_txid_s),
    "delta_count": len(deltas),
    "last_export_ops": int(last_ops_s),
    "encrypted": True,
    "key_id": key_id,
    "aad": aad,
    "secrets_aad": sec_aad,
    "secrets_backed_up": sec_up,
    "secrets_verified": sec_ver,
    "secrets_entries": int(sec_ent_s),
    "offhost_mode": off_mode,
    "offhost_target": off_target,
    "offhost_ok": off_ok,
    "offhost_pushed_at": off_pushed_at or prev.get("offhost_pushed_at"),
    "retention_generations_kept": len(gens),
    "verified_this_run": ver_ok,
    "last_verified_at": now_iso if ver_ok else prev.get("last_verified_at"),
    "last_verified_txid": int(ver_tx_s) if ver_ok else prev.get("last_verified_txid"),
    "last_verified_audit_entries": int(ver_audit_s) if ver_ok else prev.get("last_verified_audit_entries"),
    "last_error": None,
}
tmp = status_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(status, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, status_path)
PY

echo "[motet-modb-backup] ok gen=$CUR_GEN action=$ACTION seq=$ACKED_SEQ tx=$ACKED_TXID ops=$LAST_OPS verified=$VERIFIED_RESTORE verify_tx=$VERIFIED_TXID audit=$VERIFIED_AUDIT secrets_ok=$SECRETS_BACKED_UP secrets_verified=$SECRETS_VERIFIED offhost=$OFFHOST_MODE:$OFFHOST_OK"
