## Daily-driver responsive PWA web console for Motet, served directly by `mo serve`.
## Zero build step, strict HTML escaping (XSS-safe), mobile bottom tabs + 3-pane desktop studio.
## Talks exclusively to `/v1/*` so future native Mac and iOS apps share the exact same contract.
module WebUi
expose app_html, manifest_json, icon_svg

## Custom violet SVG icon for favicon and iOS/macOS PWA Home Screen.
fn icon_svg() : Text
  [
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\">",
    "<defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">",
    "<stop offset=\"0%\" stop-color=\"#7c6cff\"/><stop offset=\"100%\" stop-color=\"#4b3de0\"/>",
    "</linearGradient></defs>",
    "<rect width=\"128\" height=\"128\" rx=\"28\" fill=\"url(#g)\"/>",
    "<path d=\"M32 88V40l20 22 20-22v48\" fill=\"none\" stroke=\"#fff\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
    "<circle cx=\"94\" cy=\"44\" r=\"8\" fill=\"#b8ffda\"/>",
    "<path d=\"M94 52v32\" stroke=\"#fff\" stroke-width=\"9\" stroke-linecap=\"round\"/>",
    "</svg>"
  ].join("")
end

## PWA manifest so Motet installs cleanly on iPhone/iPad/macOS Home Screens.
fn manifest_json() : Text
  [
    "{",
    "\"name\":\"Motet\",",
    "\"short_name\":\"Motet\",",
    "\"description\":\"Living agent roster & T3 Code orchestrator\",",
    "\"start_url\":\"/\",",
    "\"display\":\"standalone\",",
    "\"background_color\":\"#0c0f14\",",
    "\"theme_color\":\"#7c6cff\",",
    "\"icons\":[{\"src\":\"/icon.svg\",\"sizes\":\"any\",\"type\":\"image/svg+xml\"}]",
    "}"
  ].join("")
end

fn ui_css() : Text
  [
    ":root{",
    "--bg:#0c0f14;--bg2:#121720;--panel:#161c26;--panel2:#1d2533;--hover:#232d3e;",
    "--border:#283347;--border2:#34435d;--text:#edf2fa;--muted:#8f9db5;--muted2:#64748b;",
    "--accent:#7c6cff;--accent2:#9688ff;--accent-bg:rgba(124,108,255,.15);",
    "--ok:#22c55e;--ok-bg:rgba(34,197,94,.14);",
    "--warn:#f59e0b;--warn-bg:rgba(245,158,11,.15);",
    "--bad:#ef4444;--bad-bg:rgba(239,68,68,.15);",
    "--r:12px;--r-sm:8px;--shadow:0 12px 32px rgba(0,0,0,.35)",
    "}",
    ":root[data-theme='light']{",
    "--bg:#f4f6fb;--bg2:#ffffff;--panel:#ffffff;--panel2:#f0f3f9;--hover:#e6ebf5;",
    "--border:#dce2ee;--border2:#c6d0e3;--text:#111827;--muted:#526077;--muted2:#7c8aa3;",
    "--accent:#5b4bff;--accent2:#4338ca;--accent-bg:rgba(91,75,255,.10);",
    "--shadow:0 12px 30px rgba(15,23,42,.10)",
    "}",
    "@media(prefers-color-scheme:light){:root:not([data-theme='dark']){",
    "--bg:#f4f6fb;--bg2:#ffffff;--panel:#ffffff;--panel2:#f0f3f9;--hover:#e6ebf5;",
    "--border:#dce2ee;--border2:#c6d0e3;--text:#111827;--muted:#526077;--muted2:#7c8aa3;",
    "--accent:#5b4bff;--accent2:#4338ca;--accent-bg:rgba(91,75,255,.10);",
    "--shadow:0 12px 30px rgba(15,23,42,.10)",
    "}}",
    "*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}",
    "html,body{margin:0;padding:0;height:100%;background:var(--bg);color:var(--text);font:14px/1.5 -apple-system,BlinkMacSystemFont,'SF Pro Text',Inter,system-ui,sans-serif}",
    "button,input,textarea,select{font:inherit;color:inherit}",
    "code,pre{font-family:ui-monospace,'SF Mono',SFMono-Regular,Menlo,monospace;font-size:12px}",
    "pre{margin:6px 0 0;padding:10px;border-radius:var(--r-sm);background:var(--bg);border:1px solid var(--border);overflow:auto;max-height:240px;white-space:pre-wrap;word-break:break-word}",
    ".shell{display:grid;grid-template-rows:54px 1fr;height:100dvh;overflow:hidden}",
    ".topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 16px;background:var(--bg2);border-bottom:1px solid var(--border);z-index:10}",
    ".brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:15px;letter-spacing:-.01em}",
    ".brand img{width:24px;height:24px;border-radius:6px}",
    ".top-actions{display:flex;align-items:center;gap:8px}",
    ".search-wrap{flex:1;max-width:340px;position:relative}",
    ".search-wrap input{width:100%;padding:7px 12px;border-radius:999px;border:1px solid var(--border);background:var(--panel2);font-size:13px}",
    ".search-wrap input:focus{outline:none;border-color:var(--accent)}",
    ".grid{display:grid;grid-template-columns:276px 1fr 336px;min-height:0;overflow:hidden}",
    ".rail,.right{background:var(--bg2);display:flex;flex-direction:column;min-height:0;overflow:hidden}",
    ".rail{border-right:1px solid var(--border)}.right{border-left:1px solid var(--border)}",
    ".pane-scroll{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px}",
    ".sec-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:4px}",
    ".sec-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}",
    ".bot-card{display:flex;flex-direction:column;gap:6px;padding:11px 12px;border-radius:var(--r);border:1px solid var(--border);background:var(--panel);cursor:pointer;text-align:left;transition:border-color .15s,background .15s;width:100%}",
    ".bot-card:hover{background:var(--hover)}.bot-card.active{border-color:var(--accent);background:var(--accent-bg)}",
    ".bot-top{display:flex;align-items:center;justify-content:space-between;gap:6px}",
    ".bot-name{font-weight:650;font-size:14px;display:flex;align-items:center;gap:6px}",
    ".bot-role{font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
    ".bar{height:4px;border-radius:99px;background:var(--panel2);overflow:hidden}",
    ".bar>i{display:block;height:100%;background:var(--accent);border-radius:99px}",
    ".sess-btn{display:flex;flex-direction:column;gap:2px;padding:8px 10px;border-radius:var(--r-sm);border:1px solid transparent;background:transparent;cursor:pointer;text-align:left;width:100%}",
    ".sess-btn:hover{background:var(--panel2)}.sess-btn.active{background:var(--panel2);border-color:var(--border2)}",
    ".sess-title{font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
    ".sess-meta{font-size:11px;color:var(--muted)}",
    ".center{display:flex;flex-direction:column;min-height:0;overflow:hidden;background:var(--bg)}",
    ".center-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 18px;border-bottom:1px solid var(--border);background:var(--bg2);flex-wrap:wrap}",
    ".mode-tabs{display:flex;gap:4px;background:var(--panel2);padding:3px;border-radius:10px;border:1px solid var(--border)}",
    ".mode-tab{padding:5px 11px;border-radius:7px;border:none;background:transparent;color:var(--muted);cursor:pointer;font-size:12px;font-weight:600}",
    ".mode-tab.active{background:var(--panel);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.2)}",
    ".chat-wrap{flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden}",
    ".chat-feed{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px;max-width:860px;width:100%;margin:0 auto}",
    ".empty{margin:auto;text-align:center;color:var(--muted);max-width:420px;padding:32px 16px}",
    ".empty h3{margin:0 0 6px;color:var(--text);font-size:17px}",
    ".msg{padding:11px 14px;border-radius:14px;white-space:pre-wrap;word-break:break-word;line-height:1.55;max-width:86%}",
    ".msg.user{background:var(--accent);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}",
    ".msg.user a{color:#fff;text-decoration:underline;overflow-wrap:anywhere}",
    ".msg.bot{background:var(--panel);border:1px solid var(--border);align-self:flex-start;border-bottom-left-radius:4px;white-space:normal}",
    ".msg.tool{align-self:flex-start;max-width:92%;background:var(--panel2);border:1px solid var(--border);font-size:12px;padding:8px 11px}",
    ".msg.tool pre a{color:var(--accent2);text-decoration:underline}",
    ".msg.meta{align-self:center;font-size:12px;color:var(--muted);background:transparent;padding:2px 8px}",
    ".msg details summary{cursor:pointer;font-weight:600;color:var(--muted)}",
    ".md{display:flex;flex-direction:column;gap:8px;min-width:0}",
    ".md p{margin:0}",
    ".md h1,.md h2,.md h3,.md h4{margin:4px 0 0;line-height:1.3;font-weight:700}",
    ".md h1{font-size:17px}.md h2{font-size:15.5px}.md h3{font-size:14.5px}.md h4{font-size:13.5px;color:var(--muted)}",
    ".md ul,.md ol{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px}",
    ".md li{margin:0}",
    ".md blockquote{margin:0;padding:6px 11px;border-left:3px solid var(--accent);background:var(--panel2);border-radius:0 var(--r-sm) var(--r-sm) 0;color:var(--muted)}",
    ".md hr{border:none;border-top:1px solid var(--border);margin:4px 0}",
    ".md a{color:var(--accent2);text-decoration:underline;text-underline-offset:2px;overflow-wrap:anywhere}",
    ".md a:hover{filter:brightness(1.15)}",
    ".md code{padding:1px 5px;border-radius:5px;background:var(--panel2);border:1px solid var(--border);font-size:12px}",
    ".md .code-box{border:1px solid var(--border);border-radius:var(--r-sm);overflow:hidden;background:var(--bg)}",
    ".md .code-hd{display:flex;align-items:center;justify-content:space-between;padding:4px 10px;background:var(--panel2);border-bottom:1px solid var(--border);font-size:11px;color:var(--muted)}",
    ".md .code-box pre{margin:0;border:none;border-radius:0;max-height:360px;white-space:pre;overflow-x:auto}",
    ".md .code-box pre code{padding:0;background:transparent;border:none}",
    ".md-tbl{overflow-x:auto;border:1px solid var(--border);border-radius:var(--r-sm)}",
    ".md table{width:100%;border-collapse:collapse;font-size:12.5px}",
    ".md th,.md td{padding:6px 9px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}",
    ".md th{background:var(--panel2);font-weight:650}",
    ".md tr:last-child td{border-bottom:none}",
    ".composer-wrap{border-top:1px solid var(--border);background:var(--bg2);padding:12px 16px calc(12px + env(safe-area-inset-bottom))}",
    ".composer{max-width:860px;margin:0 auto;display:flex;gap:8px;align-items:flex-end}",
    ".composer textarea{flex:1;resize:none;min-height:42px;max-height:160px;padding:10px 13px;border-radius:12px;border:1px solid var(--border);background:var(--panel);line-height:1.4}",
    ".composer textarea:focus{outline:none;border-color:var(--accent)}",
    ".btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 13px;border-radius:10px;border:1px solid transparent;background:var(--accent);color:#fff;font-weight:600;font-size:13px;cursor:pointer;min-height:36px;white-space:nowrap}",
    ".btn:hover{filter:brightness(1.08)}.btn:disabled{opacity:.5;cursor:not-allowed}",
    ".btn.sm{padding:5px 10px;font-size:12px;min-height:30px;border-radius:8px}",
    ".btn.ghost{background:var(--panel2);color:var(--text);border-color:var(--border)}",
    ".btn.ghost:hover{background:var(--hover)}.btn.ok{background:var(--ok);color:#04200e}",
    ".btn.bad{background:var(--bad);color:#fff}",
    ".pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--panel2);border:1px solid var(--border);color:var(--muted);white-space:nowrap}",
    ".pill.ok{background:var(--ok-bg);color:var(--ok);border-color:transparent}",
    ".pill.warn{background:var(--warn-bg);color:var(--warn);border-color:transparent}",
    ".pill.bad{background:var(--bad-bg);color:var(--bad);border-color:transparent}",
    ".pill.acc{background:var(--accent-bg);color:var(--accent2);border-color:transparent}",
    ".card{padding:12px;border-radius:var(--r);border:1px solid var(--border);background:var(--panel);display:flex;flex-direction:column;gap:8px}",
    ".row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}",
    ".between{justify-content:space-between}",
    ".ops-wrap{flex:1;overflow-y:auto;padding:18px;max-width:920px;width:100%;margin:0 auto;display:none;flex-direction:column;gap:14px}",
    ".ops-wrap.show{display:flex}.chat-wrap.hide{display:none}",
    ".subtabs{display:flex;gap:6px;flex-wrap:wrap}",
    ".field{display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px}",
    ".field label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}",
    ".field input,.field textarea,.field select{padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg2);width:100%}",
    ".field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:var(--accent)}",
    ".modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.58);display:none;align-items:center;justify-content:center;padding:16px;z-index:50}",
    ".modal-bg.open{display:flex}",
    ".modal{background:var(--panel);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);width:100%;max-width:580px;max-height:88dvh;display:flex;flex-direction:column;overflow:hidden}",
    ".modal-h{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}",
    ".modal-b{padding:16px 18px;overflow-y:auto;display:flex;flex-direction:column;gap:12px}",
    ".modal-f{padding:12px 18px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}",
    ".toast{position:fixed;right:18px;bottom:76px;background:var(--panel);border:1px solid var(--border2);color:var(--text);padding:10px 14px;border-radius:10px;box-shadow:var(--shadow);font-size:13px;display:none;z-index:60;max-width:340px}",
    ".toast.show{display:block}",
    ".mob-nav{display:none}",
    "@media(max-width:980px){",
    ".shell{grid-template-rows:52px 1fr calc(58px + env(safe-area-inset-bottom))}",
    ".search-wrap{display:none}",
    ".grid{grid-template-columns:1fr;position:relative}",
    ".rail,.center,.right{display:none;border:none}",
    ".grid[data-mob='chat'] .center{display:flex}",
    ".grid[data-mob='roster'] .rail{display:flex}",
    ".grid[data-mob='inbox'] .right{display:flex}",
    ".grid[data-mob='ops'] .center{display:flex}",
    ".composer-wrap{padding:10px 12px}",
    ".center-bar .mode-tabs{display:none}",
    ".top-actions .btn{padding:5px 8px;font-size:11px}",
    ".mob-nav{display:grid;grid-template-columns:repeat(4,1fr);background:var(--bg2);border-top:1px solid var(--border);padding:4px 6px env(safe-area-inset-bottom)}",
    ".mob-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border:none;background:transparent;color:var(--muted);font-size:11px;font-weight:600;cursor:pointer;position:relative}",
    ".mob-btn.active{color:var(--accent2)}",
    ".mob-badge{position:absolute;top:2px;right:22%;background:var(--bad);color:#fff;font-size:10px;padding:0 5px;border-radius:99px;display:none}",
    ".mob-badge.show{display:inline-block}",
    "}"
  ].join("")
end

fn ui_markup() : Text
  [
    "<div class=\"shell\">",
    "<header class=\"topbar\">",
    "<div class=\"brand\"><img src=\"/icon.svg\" alt=\"\"><span>Motet</span><span id=\"healthPill\" class=\"pill\">connecting…</span></div>",
    "<div class=\"search-wrap\"><input id=\"globalSearch\" type=\"search\" placeholder=\"Search sessions & memory… (⌘K)\"></div>",
    "<div class=\"top-actions\">",
    "<button class=\"btn sm ghost\" onclick=\"tickRoutines()\">Run Routines</button>",
    "<button class=\"btn sm ghost\" onclick=\"openBotModal(null)\">+ Bot</button>",
    "<button class=\"btn sm ghost\" onclick=\"openSettings()\">Settings</button>",
    "</div>",
    "</header>",
    "<div id=\"grid\" class=\"grid\" data-mob=\"chat\">",
    "<aside class=\"rail\">",
    "<div class=\"pane-scroll\">",
    "<div class=\"sec-head\"><span class=\"sec-title\">Bot Roster</span><button class=\"btn sm ghost\" onclick=\"openBotModal(null)\">+ New</button></div>",
    "<div id=\"botList\" style=\"display:flex;flex-direction:column;gap:8px\"></div>",
    "<div class=\"sec-head\"><span class=\"sec-title\">Recent Sessions</span><button class=\"btn sm ghost\" onclick=\"newSession()\">New</button></div>",
    "<div id=\"sessionList\" style=\"display:flex;flex-direction:column;gap:4px\"></div>",
    "</div>",
    "</aside>",
    "<main class=\"center\">",
    "<div class=\"center-bar\">",
    "<div class=\"row\">",
    "<strong id=\"activeBotTitle\" style=\"font-size:15px\">chief</strong>",
    "<span id=\"activeBotMeta\" class=\"pill acc\"></span>",
    "<button class=\"btn sm ghost\" onclick=\"editActiveBot()\">Edit Bot</button>",
    "</div>",
    "<div class=\"row\">",
    "<div class=\"mode-tabs\">",
    "<button id=\"tabChat\" class=\"mode-tab active\" onclick=\"setCenterMode('chat')\">Chat</button>",
    "<button id=\"tabOps\" class=\"mode-tab\" onclick=\"setCenterMode('ops')\">Ops &amp; Tools</button>",
    "</div>",
    "<button class=\"btn sm ghost\" onclick=\"newSession()\">New Chat</button>",
    "</div>",
    "</div>",
    "<div id=\"chatWrap\" class=\"chat-wrap\">",
    "<div id=\"chatFeed\" class=\"chat-feed\"></div>",
    "<div class=\"composer-wrap\">",
    "<form class=\"composer\" onsubmit=\"sendAsk(event)\">",
    "<textarea id=\"promptInput\" rows=\"1\" placeholder=\"Message chief…\"></textarea>",
    "<button id=\"sendBtn\" class=\"btn\" type=\"submit\">Send</button>",
    "</form>",
    "</div>",
    "</div>",
    "<div id=\"opsWrap\" class=\"ops-wrap\">",
    "<div class=\"subtabs\" id=\"opsTabs\">",
    "<button class=\"btn sm\" data-ops=\"memory\" onclick=\"setOpsTab('memory')\">Memory</button>",
    "<button class=\"btn sm ghost\" data-ops=\"skills\" onclick=\"setOpsTab('skills')\">Skills</button>",
    "<button class=\"btn sm ghost\" data-ops=\"routines\" onclick=\"setOpsTab('routines')\">Routines</button>",
    "<button class=\"btn sm ghost\" data-ops=\"connectors\" onclick=\"setOpsTab('connectors')\">Connectors</button>",
    "<button class=\"btn sm ghost\" data-ops=\"rules\" onclick=\"setOpsTab('rules')\">Policy Rules</button>",
    "<button class=\"btn sm ghost\" data-ops=\"artifacts\" onclick=\"setOpsTab('artifacts')\">Artifacts</button>",
    "<button class=\"btn sm ghost\" data-ops=\"search\" onclick=\"setOpsTab('search')\">Search</button>",
    "</div>",
    "<div id=\"opsBody\" style=\"display:flex;flex-direction:column;gap:12px\"></div>",
    "</div>",
    "</main>",
    "<aside class=\"right\">",
    "<div class=\"pane-scroll\">",
    "<div class=\"sec-head\">",
    "<span class=\"sec-title\">Needs You Inbox</span>",
    "<div class=\"row\" style=\"gap:6px\">",
    "<button id=\"dismissAllBtn\" class=\"btn sm ghost\" style=\"display:none\" onclick=\"dismissAllInbox()\">Dismiss All</button>",
    "<div class=\"mode-tabs\">",
    "<button id=\"ibPend\" class=\"mode-tab active\" onclick=\"setInboxFilter(true)\">Pending</button>",
    "<button id=\"ibAll\" class=\"mode-tab\" onclick=\"setInboxFilter(false)\">All</button>",
    "</div>",
    "</div>",
    "</div>",
    "<div id=\"inboxList\" style=\"display:flex;flex-direction:column;gap:8px\"></div>",
    "<div class=\"sec-head\"><span class=\"sec-title\">Daily Budgets</span><a href=\"/docs\" target=\"_blank\" class=\"pill\" style=\"text-decoration:none\">OpenAPI /docs</a></div>",
    "<div id=\"budgetList\" style=\"display:flex;flex-direction:column;gap:8px\"></div>",
    "</div>",
    "</aside>",
    "</div>",
    "<nav class=\"mob-nav\">",
    "<button id=\"mChat\" class=\"mob-btn active\" onclick=\"setMob('chat')\"><span>💬</span><span>Chat</span></button>",
    "<button id=\"mInbox\" class=\"mob-btn\" onclick=\"setMob('inbox')\"><span>⚡</span><span>Inbox</span><span id=\"mobBadge\" class=\"mob-badge\">0</span></button>",
    "<button id=\"mRoster\" class=\"mob-btn\" onclick=\"setMob('roster')\"><span>🤖</span><span>Roster</span></button>",
    "<button id=\"mOps\" class=\"mob-btn\" onclick=\"setMob('ops')\"><span>🧰</span><span>Ops</span></button>",
    "</nav>",
    "</div>",
    "<div id=\"modalBg\" class=\"modal-bg\" onclick=\"if(event.target===this)closeModal()\">",
    "<div class=\"modal\"><div class=\"modal-h\"><strong id=\"modalTitle\">Modal</strong><button class=\"btn sm ghost\" onclick=\"closeModal()\">✕</button></div><div id=\"modalBody\" class=\"modal-b\"></div><div id=\"modalFoot\" class=\"modal-f\"></div></div>",
    "</div>",
    "<div id=\"toast\" class=\"toast\"></div>"
  ].join("")
end

fn ui_script() : Text
  [
    "<script>",
    "const S={bots:[],sessions:[],inbox:[],budgets:[],connectors:[],connAuth:[],routines:[],skills:[],memory:[],rules:[],artifacts:[],activeBot:'chief',sessionId:null,centerMode:'chat',opsTab:'memory',inboxPending:true,sending:false,searchHits:[]};",
    "const $=id=>document.getElementById(id);",
    "const esc=v=>String(v==null?'':v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));",
    "function safeHref(raw){const u=String(raw||'').trim();return /^https?:\\/\\//i.test(u)?u:null;}",
    "function splitUrlTrail(raw){let u=raw,tr='';while(u.length){const ch=u[u.length-1];if('.,;:!?'.includes(ch)){tr=ch+tr;u=u.slice(0,-1);}else if(ch===')'&&(u.match(/\\(/g)||[]).length<(u.match(/\\)/g)||[]).length){tr=ch+tr;u=u.slice(0,-1);}else if(ch===']'&&(u.match(/\\[/g)||[]).length<(u.match(/\\]/g)||[]).length){tr=ch+tr;u=u.slice(0,-1);}else break;}return [u,tr];}",
    "function linkifyPlain(txt){return esc(txt).replace(/https?:\\/\\/[^\\s<>\"'\\u0000]+/g,m=>{const [u,tr]=splitUrlTrail(m);const clean=u.replace(/&amp;/g,'&');const h=safeHref(clean);return h?'<a href=\"'+esc(h)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+u+'</a>'+tr:m;});}",
    "function copyCodeBtn(btn){const pre=btn.closest('.code-box').querySelector('pre');if(!pre)return;navigator.clipboard.writeText(pre.textContent||'').then(()=>{btn.textContent='Copied';setTimeout(()=>btn.textContent='Copy',1400);}).catch(()=>toast('Copy failed'));}",
    "function mdInline(raw){const codes=[],links=[];let s=esc(raw);s=s.replace(/`([^`\\n]+)`/g,(_,c)=>{const i=codes.push('<code>'+c+'</code>')-1;return '\\u0000IC'+i+'\\u0000';});s=s.replace(/\\[([^\\]\\n]+)\\]\\(([^)\\s]+)\\)/g,(m,lbl,url)=>{const h=safeHref(url.replace(/&amp;/g,'&'));if(!h)return lbl;const i=links.push('<a href=\"'+esc(h)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+lbl+'</a>')-1;return '\\u0000LK'+i+'\\u0000';});s=s.replace(/https?:\\/\\/[^\\s<>\"'\\u0000]+/g,m=>{const [u,tr]=splitUrlTrail(m);const h=safeHref(u.replace(/&amp;/g,'&'));if(!h)return m;const i=links.push('<a href=\"'+esc(h)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+u+'</a>')-1;return '\\u0000LK'+i+'\\u0000'+tr;});s=s.replace(/\\*\\*\\*(.+?)\\*\\*\\*/g,'<strong><em>$1</em></strong>').replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>').replace(/~~(.+?)~~/g,'<del>$1</del>').replace(/(^|[\\s(\\[{\\-–—])\\*([^\\s*](?:[^*]*?[^\\s*])?)\\*(?=$|[\\s)\\].,;:!?])/g,'$1<em>$2</em>');s=s.replace(/\\u0000LK(\\d+)\\u0000/g,(_,i)=>links[Number(i)]).replace(/\\u0000IC(\\d+)\\u0000/g,(_,i)=>codes[Number(i)]);return s;}",
    "function renderMd(src){const text=String(src==null?'':src).replace(/\\r\\n?/g,'\\n');const fenced=[];const body=text.replace(/```([a-zA-Z0-9_+-]*)\\n([\\s\\S]*?)```/g,(_,lang,code)=>{const idx=fenced.push('<div class=\"code-box\"><div class=\"code-hd\"><span>'+esc(lang||'code')+'</span><button type=\"button\" class=\"btn sm ghost\" style=\"min-height:22px;padding:1px 7px;font-size:11px\" onclick=\"copyCodeBtn(this)\">Copy</button></div><pre><code>'+esc(code.replace(/\\n$/,''))+'</code></pre></div>')-1;return '\\n\\u0000CB'+idx+'\\u0000\\n';});const lines=body.split('\\n');const out=[];let i=0;const isSep=l=>/^\\|?\\s*:?-{3,}:?\\s*(\\|\\s*:?-{3,}:?\\s*)+\\|?$/.test(l.trim());const splitRow=l=>l.trim().replace(/^\\|/, '').replace(/\\|$/, '').split('|').map(c=>c.trim());while(i<lines.length){const l=lines[i],tr=l.trim();if(!tr){i++;continue;}const cb=tr.match(/^\\u0000CB(\\d+)\\u0000$/);if(cb){out.push(fenced[Number(cb[1])]);i++;continue;}const hd=l.match(/^([#]{1,4})\\s+(.+)$/);if(hd){const n=hd[1].length;out.push('<h'+n+'>'+mdInline(hd[2])+'</h'+n+'>');i++;continue;}if(/^(-{3,}|\\*{3,}|_{3,})$/.test(tr)){out.push('<hr>');i++;continue;}if(tr.startsWith('>')){const bq=[];while(i<lines.length&&lines[i].trim().startsWith('>')){bq.push(mdInline(lines[i].trim().replace(/^>\\s?/,'')));i++;}out.push('<blockquote>'+bq.join('<br>')+'</blockquote>');continue;}if(l.includes('|')&&i+1<lines.length&&isSep(lines[i+1])){const th=splitRow(l);i+=2;const rows=[];while(i<lines.length&&lines[i].includes('|')&&lines[i].trim()){rows.push(splitRow(lines[i]));i++;}out.push('<div class=\"md-tbl\"><table><thead><tr>'+th.map(c=>'<th>'+mdInline(c)+'</th>').join('')+'</tr></thead><tbody>'+rows.map(r=>'<tr>'+th.map((_,k)=>'<td>'+mdInline(r[k]||'')+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>');continue;}if(/^\\s*[-*•]\\s+/.test(l)){const items=[];while(i<lines.length&&/^\\s*[-*•]\\s+/.test(lines[i])){items.push('<li>'+mdInline(lines[i].replace(/^\\s*[-*•]\\s+/,''))+'</li>');i++;}out.push('<ul>'+items.join('')+'</ul>');continue;}if(/^\\s*\\d+\\.\\s+/.test(l)){const items=[];while(i<lines.length&&/^\\s*\\d+\\.\\s+/.test(lines[i])){items.push('<li>'+mdInline(lines[i].replace(/^\\s*\\d+\\.\\s+/,''))+'</li>');i++;}out.push('<ol>'+items.join('')+'</ol>');continue;}const para=[];while(i<lines.length){const cur=lines[i],ct=cur.trim();if(!ct||/^\\u0000CB\\d+\\u0000$/.test(ct)||/^[#]{1,4}\\s+/.test(cur)||/^(-{3,}|\\*{3,}|_{3,})$/.test(ct)||ct.startsWith('>')||/^\\s*[-*•]\\s+/.test(cur)||/^\\s*\\d+\\.\\s+/.test(cur)||(cur.includes('|')&&i+1<lines.length&&isSep(lines[i+1])))break;para.push(mdInline(cur));i++;}if(para.length)out.push('<p>'+para.join('<br>')+'</p>');}return '<div class=\"md\">'+out.join('')+'</div>';}",
    "function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._tm);t._tm=setTimeout(()=>t.classList.remove('show'),3400);}",
    "function applyTheme(){const th=localStorage.getItem('motet_theme')||'auto';if(th==='auto')document.documentElement.removeAttribute('data-theme');else document.documentElement.setAttribute('data-theme',th);}",
    "function hdrs(){const h={'Content-Type':'application/json'};const tok=localStorage.getItem('motet_token')||'';if(tok)h['Authorization']='Bearer '+tok;return h;}",
    "async function api(path,opts={}){const r=await fetch(path,{...opts,headers:{...hdrs(),...(opts.headers||{})}});if(r.status===204)return null;const txt=await r.text();if(!r.ok){let msg=txt||('HTTP '+r.status);try{const j=JSON.parse(txt);msg=(j.detail&&j.detail.message)||j.message||j.error||msg;}catch(_){}throw new Error(msg);}try{return JSON.parse(txt);}catch(_){return txt;}}",
    "function openModal(title,bodyHtml,footHtml){$('modalTitle').textContent=title;$('modalBody').innerHTML=bodyHtml;$('modalFoot').innerHTML=footHtml||'';$('modalBg').classList.add('open');}",
    "function closeModal(){$('modalBg').classList.remove('open');}",
    "function setMob(tab){$('grid').setAttribute('data-mob',tab);['Chat','Inbox','Roster','Ops'].forEach(k=>$('m'+k).classList.toggle('active',tab===k.toLowerCase()));if(tab==='ops')setCenterMode('ops');else if(tab==='chat')setCenterMode('chat');}",
    "function setCenterMode(m){S.centerMode=m;$('tabChat').classList.toggle('active',m==='chat');$('tabOps').classList.toggle('active',m==='ops');$('chatWrap').classList.toggle('hide',m!=='chat');$('opsWrap').classList.toggle('show',m==='ops');if(m==='ops')renderOps();}",
    "function setOpsTab(t){S.opsTab=t;document.querySelectorAll('#opsTabs button').forEach(b=>{const on=b.dataset.ops===t;b.className='btn sm'+(on?'':' ghost');});renderOps();}",
    "function setInboxFilter(pend){S.inboxPending=pend;$('ibPend').classList.toggle('active',pend);$('ibAll').classList.toggle('active',!pend);loadInbox();}",
    "function findBot(n){return S.bots.find(b=>b.name===n)||S.bots[0];}",
    "function renderBots(){const el=$('botList');if(!S.bots.length){el.innerHTML='<span class=\"pill\">No bots</span>';return;}const bmap={};S.budgets.forEach(b=>bmap[b.bot_name]=b);el.innerHTML=S.bots.map(b=>{const q=bmap[b.name];const spent=q?Number(q.spent_usd):0;const lim=Number(b.daily_budget_usd)||1;const pct=Math.min(100,Math.round((spent/lim)*100));return '<button class=\"bot-card'+(b.name===S.activeBot?' active':'')+'\" onclick=\"selectBot(\\''+esc(b.name)+'\\')\"><div class=\"bot-top\"><span class=\"bot-name\">'+esc(b.name)+(b['is_primary?']?' <span class=\"pill acc\">primary</span>':'')+'</span><span class=\"pill\">'+esc(b.model_tier)+'</span></div><div class=\"bot-role\">'+esc(b.role)+' · '+esc(b.model)+'</div><div class=\"bar\"><i style=\"width:'+pct+'%\"></i></div></button>';}).join('');const cur=findBot(S.activeBot);if(cur){$('activeBotTitle').textContent=cur.name;$('activeBotMeta').textContent=cur.role+' · '+cur.model;$('promptInput').placeholder='Message '+cur.name+'…';}}",
    "function renderSessions(){const el=$('sessionList');const items=S.sessions.filter(s=>s.bot_name===S.activeBot);if(!items.length){el.innerHTML='<div style=\"font-size:12px;color:var(--muted);padding:4px\">No sessions yet</div>';return;}el.innerHTML=items.slice(0,25).map(s=>'<button class=\"sess-btn'+(s.id===S.sessionId?' active':'')+'\" onclick=\"openSession(\\''+esc(s.id)+'\\')\"><span class=\"sess-title\">'+esc(s.title||s.id)+'</span><span class=\"sess-meta\">'+esc(s.trust)+' · '+s.event_count+' events</span></button>').join('');}",
    "function renderEmptyChat(){const cur=findBot(S.activeBot);$('chatFeed').innerHTML='<div class=\"empty\"><h3>'+esc(cur?cur.name:S.activeBot)+'</h3><div>'+esc(cur?cur.persona:'Ready to help.')+'</div><div class=\"row\" style=\"justify-content:center;margin-top:14px\"><button class=\"btn sm ghost\" onclick=\"quickAsk(\\'Search the web for the latest news on Anthropic Claude and summarize the top 3 updates with URLs.\\')\">Search the web</button><button class=\"btn sm ghost\" onclick=\"quickAsk(\\'Delegate a quick read-only check to builder to review what skills and workspace files exist, then summarize.\\')\">Delegate to builder</button><button class=\"btn sm ghost\" onclick=\"quickAsk(\\'Summarize your teammates, tools, connectors, and skills.\\')\">Check capabilities</button></div></div>';}",
    "function quickAsk(text){$('promptInput').value=text;sendAsk(new Event('submit'));}",
    "function appendChatEl(cls,html){const f=$('chatFeed');if(f.querySelector('.empty'))f.innerHTML='';const d=document.createElement('div');d.className='msg '+cls;d.innerHTML=html;f.appendChild(d);f.scrollTop=f.scrollHeight;}",
    "async function selectBot(name){S.activeBot=name;S.sessionId=null;renderBots();renderSessions();renderEmptyChat();if(window.innerWidth<=980)setMob('chat');}",
    "function newSession(){S.sessionId=null;renderSessions();renderEmptyChat();setCenterMode('chat');$('promptInput').focus();}",
    "async function openSession(sid){S.sessionId=sid;setCenterMode('chat');renderSessions();const f=$('chatFeed');f.innerHTML='<div class=\"msg meta\">Loading session…</div>';try{const evs=await api('/v1/sessions/'+encodeURIComponent(sid)+'/events');f.innerHTML='';if(!evs.length){renderEmptyChat();return;}for(const e of evs){if(e.kind==='message'&&e.role==='user')appendChatEl('user',linkifyPlain(e.content));else if(e.kind==='message'&&e.role==='assistant')appendChatEl('bot',renderMd(e.content));else if(e.kind==='assistant_tools'){if(e.content&&e.content.trim())appendChatEl('bot',renderMd(e.content));}else if(e.kind==='tool_result'||e.kind==='approval_executed')appendChatEl('tool','<details><summary>Tool: '+esc(e.tool_name||'tool')+'</summary><pre>'+linkifyPlain(e.content)+'</pre></details>');else if(e.kind==='webhook')appendChatEl('tool','<strong>External webhook</strong><pre>'+linkifyPlain(e.content)+'</pre>');else appendChatEl('meta',esc(e.kind+': '+e.content));}}catch(err){f.innerHTML='<div class=\"msg meta\">'+esc(err.message)+'</div>';}if(window.innerWidth<=980)setMob('chat');}",
    "async function sendAsk(ev){ev.preventDefault();if(S.sending)return;const inp=$('promptInput');const msg=inp.value.trim();if(!msg)return;inp.value='';inp.style.height='auto';S.sending=true;$('sendBtn').disabled=true;appendChatEl('user',linkifyPlain(msg));appendChatEl('meta','Thinking…');try{const res=await api('/v1/bots/'+encodeURIComponent(S.activeBot)+'/ask',{method:'POST',body:JSON.stringify({message:msg,session_id:S.sessionId})});S.sessionId=res.session_id;const feed=$('chatFeed');if(feed.lastChild&&feed.lastChild.textContent==='Thinking…')feed.removeChild(feed.lastChild);appendChatEl('bot',renderMd(res.reply||'(no reply)'));if(res.pending_approvals&&res.pending_approvals.length){for(const a of res.pending_approvals){appendChatEl('tool','<div class=\"row between\"><strong>Needs You #'+a.id+' · '+esc(a.tool_name)+'</strong><span class=\"pill warn\">'+esc(a.effect_class)+'</span></div><div style=\"color:var(--muted);margin:4px 0\">'+esc(a.reason)+'</div><pre>'+esc(a.arguments_json)+'</pre><div class=\"row\" style=\"margin-top:8px\"><button class=\"btn sm ok\" onclick=\"resolveApproval('+a.id+',true)\">Approve &amp; Run</button><button class=\"btn sm bad\" onclick=\"resolveApproval('+a.id+',false)\">Deny</button></div>');}}appendChatEl('meta','steps '+res.steps+' · $'+res.spent_usd+(res.stopped_reason?' · '+esc(res.stopped_reason):''));await refreshAll();}catch(err){const feed=$('chatFeed');if(feed.lastChild&&feed.lastChild.textContent==='Thinking…')feed.removeChild(feed.lastChild);appendChatEl('meta','Error: '+esc(err.message));}finally{S.sending=false;$('sendBtn').disabled=false;}}",
    "function effectPill(eff){const c=eff==='irreversible'?'bad':eff==='write_external'?'warn':eff==='read'?'ok':'acc';return '<span class=\"pill '+c+'\">'+esc(eff)+'</span>';}",
    "function renderInbox(){const el=$('inboxList');const pendCount=S.inbox.filter(a=>a.status==='pending').length;const b=$('mobBadge');b.textContent=String(pendCount);b.classList.toggle('show',pendCount>0);const db=$('dismissAllBtn');if(db)db.style.display=pendCount>0?'inline-flex':'none';if(!S.inbox.length){el.innerHTML='<div class=\"card\" style=\"color:var(--muted);text-align:center\">Nothing blocked</div>';return;}el.innerHTML=S.inbox.map(a=>{let prettyArgs=a.arguments_json;try{prettyArgs=JSON.stringify(JSON.parse(a.arguments_json),null,2);}catch(_){}return '<div class=\"card\"><div class=\"row between\"><strong>#'+a.id+' '+esc(a.bot_name)+'</strong>'+effectPill(a.effect_class)+'</div><div><code>'+esc(a.tool_name)+'</code></div><div style=\"font-size:12px;color:var(--muted)\">'+esc(a.reason)+'</div><pre>'+esc(prettyArgs)+'</pre>'+(a.status==='pending'?'<div class=\"row\"><button class=\"btn sm ok\" onclick=\"resolveApproval('+a.id+',true)\">Approve &amp; Run</button><button class=\"btn sm bad\" onclick=\"resolveApproval('+a.id+',false)\">Deny</button></div>':'<div class=\"row between\"><span class=\"pill\">'+esc(a.status)+'</span></div>'+(a.result_text?'<pre>'+esc(a.result_text)+'</pre>':''))+'</div>';}).join('');}",
    "function renderBudgets(){const el=$('budgetList');if(!S.budgets.length){el.innerHTML='<span class=\"pill\">No spend yet</span>';return;}el.innerHTML=S.budgets.map(b=>{const pct=Number(b.limit_usd)>0?Math.min(100,Math.round((Number(b.spent_usd)/Number(b.limit_usd))*100)):0;return '<div class=\"card\" style=\"gap:5px\"><div class=\"row between\"><strong>'+esc(b.bot_name)+'</strong><span style=\"font-size:12px\">$'+esc(b.spent_usd)+' / $'+esc(b.limit_usd)+'</span></div><div class=\"bar\"><i style=\"width:'+pct+'%\"></i></div><div style=\"font-size:11px;color:var(--muted)\">'+b.turns+' turns · '+b.input_tokens+' in / '+b.output_tokens+' out</div></div>';}).join('');}",
    "async function resolveApproval(id,yes){try{const res=await api('/v1/inbox/'+id+'/'+(yes?'approve':'deny'),{method:'POST'});toast('Approval #'+id+' -> '+res.status);await refreshAll();if(S.sessionId)await openSession(S.sessionId);}catch(e){toast('Failed: '+e.message);}}",
    "async function dismissAllInbox(){try{const res=await api('/v1/inbox/dismiss-all',{method:'POST'});toast('Dismissed '+res.affected+' pending approval(s)');await refreshAll();}catch(e){toast('Failed: '+e.message);}}",
    "async function tickRoutines(){try{const r=await api('/v1/routines/tick',{method:'POST'});toast('Routines ran: '+r.routines_ran+', approvals: '+r.approvals_created);await refreshAll();}catch(e){toast('Tick error: '+e.message);}}",
    "function renderOps(){const el=$('opsBody');const t=S.opsTab;if(t==='memory'){el.innerHTML='<form class=\"card\" onsubmit=\"addMemory(event)\"><strong>Add Durable Memory</strong><div class=\"row\"><div class=\"field\"><label>Scope</label><input id=\"mScope\" value=\"shared\" placeholder=\"shared or bot name\"></div><div class=\"field\"><label>Kind</label><select id=\"mKind\"><option>profile</option><option>rule</option><option selected>fact</option><option>work_log</option></select></div></div><div class=\"field\"><label>Content</label><input id=\"mContent\" placeholder=\"e.g. Prefer concise PR summaries and run mo test first\"></div><div><button class=\"btn sm\" type=\"submit\">Save Memory</button></div></form>'+(S.memory.map(m=>'<div class=\"card\"><div class=\"row between\"><span class=\"pill acc\">'+esc(m.scope)+' / '+esc(m.kind)+'</span><div class=\"row\"><span style=\"font-size:11px;color:var(--muted)\">'+esc(m.provenance)+' · '+esc(m.created_at)+'</span><button class=\"btn sm ghost\" onclick=\"deleteMemory('+m.id+')\">Delete</button></div></div><div>'+esc(m.content)+'</div></div>').join('')||'<div class=\"card\">No memories saved yet.</div>');}",
    "else if(t==='skills'){el.innerHTML='<div class=\"row between\"><strong>Progressive Skills (SKILL.md)</strong><button class=\"btn sm\" onclick=\"openSkillModal(null)\">+ New Skill</button></div>'+(S.skills.map(k=>'<div class=\"card\"><div class=\"row between\"><strong>'+esc(k.name)+'</strong><span class=\"pill\">'+esc(k.provenance)+'</span></div><div style=\"color:var(--muted);font-size:13px\">'+esc(k.description)+'</div><div class=\"row\"><button class=\"btn sm ghost\" onclick=\"viewSkill(\\''+esc(k.name)+'\\')\">Read / Edit SKILL.md</button></div></div>').join('')||'<div class=\"card\">No skills installed yet.</div>');}",
    "else if(t==='routines'){el.innerHTML='<form class=\"card\" onsubmit=\"addRoutine(event)\"><strong>Add Standing Routine</strong><div class=\"row\"><div class=\"field\"><label>Bot</label><select id=\"rBot\">'+S.bots.map(b=>'<option value=\"'+esc(b.name)+'\">'+esc(b.name)+'</option>').join('')+'</select></div><div class=\"field\"><label>Name</label><input id=\"rName\" placeholder=\"ci-watchdog\"></div><div class=\"field\"><label>Interval (sec)</label><input id=\"rInt\" type=\"number\" value=\"900\" min=\"60\"></div></div><div class=\"field\"><label>Standing Responsibility Prompt</label><textarea id=\"rPrompt\" rows=\"2\" placeholder=\"Check T3 threads and open PRs...\"></textarea></div><div class=\"row between\"><label style=\"font-size:12px\"><input id=\"rRo\" type=\"checkbox\" checked> Read-only proactive default</label><button class=\"btn sm\" type=\"submit\">Save Routine</button></div></form>'+(S.routines.map(r=>'<div class=\"card\"><div class=\"row between\"><strong>'+esc(r.bot_name)+':'+esc(r.name)+'</strong><div class=\"row\">'+(r['enabled?']?'':'<span class=\"pill warn\">paused</span>')+'<span class=\"pill '+(r['read_only?']?'ok':'warn')+'\">'+(r['read_only?']?'read-only':'read-write')+' · every '+r.interval_seconds+'s</span></div></div><div style=\"font-size:13px\">'+esc(r.prompt)+'</div><div class=\"row between\"><span style=\"font-size:11px;color:var(--muted)\">next: '+esc(r.next_due_at)+(r.last_run_at?' · last: '+esc(r.last_run_at):'')+'</span><div class=\"row\"><button class=\"btn sm ghost\" onclick=\"toggleRoutine('+r.id+','+(!r['enabled?'])+')\">'+(r['enabled?']?'Pause':'Resume')+'</button><button class=\"btn sm ghost\" onclick=\"deleteRoutine('+r.id+')\">Delete</button></div></div></div>').join('')||'<div class=\"card\">No routines configured yet.</div>');}",
    "else if(t==='connectors'){const amap={};S.connAuth.forEach(a=>amap[a.connector_name]=a);const t3=S.connectors.find(c=>c.name==='t3code');const t3a=amap['t3code'];const showT3Guide=!t3||!t3a||!t3a['connected?']||t3.url.includes('127.0.0.1');el.innerHTML=(showT3Guide?'<div class=\"card\" style=\"border-color:var(--accent)\"><strong>Connect T3 Code (3 quick steps)</strong><div style=\"font-size:12.5px;color:var(--muted)\">1. In T3 Code open <b>Settings → Environments → Copy MCP URL</b> (with T3 Connect on).<br>2. Click <b>Edit URL</b> on <code>t3code</code> below and paste that <code>https://…/mcp</code> URL.<br>3. Click <b>Connect OAuth</b>, approve in T3 Code, then click <b>Test Tools</b>.</div></div>':'')+'<form class=\"card\" onsubmit=\"addConnector(event)\"><strong>Mount HTTP MCP Connector</strong><div class=\"row\"><div class=\"field\"><label>Name</label><input id=\"cName\" placeholder=\"notion, linear, slack, github\"></div><div class=\"field\"><label>MCP Endpoint URL</label><input id=\"cUrl\" placeholder=\"https://mcp.notion.com/mcp\"></div></div><div class=\"row\"><div class=\"field\"><label>Auth Token Env Var (optional if using OAuth)</label><input id=\"cEnv\" placeholder=\"NOTION_TOKEN\"></div><div class=\"field\"><label>Default Effect</label><select id=\"cEff\"><option value=\"write_external\">WriteExternal (Ask First)</option><option value=\"read\">Read (Auto Allow)</option><option value=\"irreversible\">Irreversible</option></select></div></div><div><button class=\"btn sm\" type=\"submit\">Mount Connector</button></div></form>'+(S.connectors.map(c=>{const au=amap[c.name]||{};const conn=!!au['connected?'];const src=au.source||'none';return '<div class=\"card\"><div class=\"row between\"><strong>'+esc(c.name)+'</strong><div class=\"row\">'+(conn?'<span class=\"pill ok\">connected ('+esc(src)+')</span>':'<span class=\"pill warn\">not signed in</span>')+(c['enabled?']?'':'<span class=\"pill warn\">disabled</span>')+effectPill(c.default_effect)+'</div></div><div><code>'+esc(c.url)+'</code></div><div style=\"font-size:12px;color:var(--muted)\">host pin: '+esc(c.allowed_host)+' · auth env: '+esc(c.auth_env||'(none)')+(au.scope?' · scope: '+esc(au.scope):'')+'</div><div class=\"row\"><button class=\"btn sm\" onclick=\"startOAuth(\\''+esc(c.name)+'\\')\">'+(conn&&src==='oauth'?'Reconnect OAuth':'Connect OAuth')+'</button><button class=\"btn sm ghost\" onclick=\"openEditConnector(\\''+esc(c.name)+'\\')\">Edit URL</button><button class=\"btn sm ghost\" onclick=\"testConnector(\\''+esc(c.name)+'\\')\">Test Tools</button>'+(conn&&src==='oauth'?'<button class=\"btn sm ghost\" onclick=\"disconnectOAuth(\\''+esc(c.name)+'\\')\">Disconnect</button>':'')+'<button class=\"btn sm ghost\" onclick=\"toggleConnector(\\''+esc(c.name)+'\\','+(!c['enabled?'])+')\">'+(c['enabled?']?'Disable':'Enable')+'</button><button class=\"btn sm ghost\" onclick=\"deleteConnector(\\''+esc(c.name)+'\\')\">Delete</button></div></div>';}).join('')||'<div class=\"card\">No connectors mounted yet.</div>');}",
    "else if(t==='rules'){el.innerHTML='<form class=\"card\" onsubmit=\"addRule(event)\"><strong>Add Host Policy Rule</strong><div class=\"row\"><div class=\"field\"><label>Bot (* for all)</label><input id=\"pBot\" value=\"*\"></div><div class=\"field\"><label>Tool Pattern</label><input id=\"pPat\" placeholder=\"t3code:t3_thread_launch or t3code:*\"></div><div class=\"field\"><label>Decision</label><select id=\"pDec\"><option value=\"allow\">Allow</option><option value=\"ask_first\">Ask First</option><option value=\"deny\">Deny</option></select></div></div><div class=\"field\"><label>Note</label><input id=\"pNote\" placeholder=\"Why this rule exists\"></div><div><button class=\"btn sm\" type=\"submit\">Add Rule</button></div></form>'+(S.rules.map(r=>'<div class=\"card\"><div class=\"row between\"><strong>'+esc(r.bot_name)+' → <code>'+esc(r.tool_pattern)+'</code></strong><div class=\"row\"><span class=\"pill\">'+esc(r.decision)+'</span><button class=\"btn sm ghost\" onclick=\"deleteRule('+r.id+')\">Delete</button></div></div><div style=\"font-size:12px;color:var(--muted)\">'+esc(r.note)+'</div></div>').join('')||'<div class=\"card\">Using default deterministic safety matrix.</div>');}",
    "else if(t==='artifacts'){el.innerHTML=S.artifacts.map(a=>'<div class=\"card\"><div class=\"row between\"><strong>'+esc(a.title)+'</strong><span class=\"pill\">'+esc(a.bot_name)+' · '+esc(a.kind)+'</span></div>'+(a.kind==='diff'?'<pre>'+esc(a.content)+'</pre>':renderMd(a.content))+'</div>').join('')||'<div class=\"card\">No artifacts saved yet.</div>';}",
    "else if(t==='search'){el.innerHTML='<form class=\"card\" onsubmit=\"runSearch(event)\"><div class=\"row\"><input id=\"opsQ\" style=\"flex:1;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg2)\" placeholder=\"Full-text search across all session event logs…\"><button class=\"btn sm\" type=\"submit\">Search</button></div></form>'+(S.searchHits.map(ev=>'<div class=\"card\"><div class=\"row between\"><strong>'+esc(ev.session_id)+' #'+ev.seq+' ('+esc(ev.role)+')</strong><button class=\"btn sm ghost\" onclick=\"openSession(\\''+esc(ev.session_id)+'\\')\">Open Session</button></div><pre>'+esc(ev.content)+'</pre></div>').join('')||'<div class=\"card\" style=\"color:var(--muted)\">Enter keywords to search session logs.</div>');}}",
    "async function addMemory(ev){ev.preventDefault();const c=$('mContent').value.trim();if(!c)return;await api('/v1/memory',{method:'POST',body:JSON.stringify({scope:$('mScope').value.trim()||'shared',kind:$('mKind').value,content:c,provenance:'user'})});toast('Memory saved');await refreshAll();renderOps();}",
    "async function deleteMemory(id){try{await api('/v1/memory/'+id,{method:'DELETE'});toast('Memory deleted');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function viewSkill(name){try{const doc=await api('/v1/skills/'+encodeURIComponent(name));openSkillModal(doc);}catch(e){toast(e.message);}}",
    "function openSkillModal(doc){openModal(doc?'Edit Skill: '+doc.name:'New Skill (SKILL.md)','<div class=\"field\"><label>Slug</label><input id=\"skName\" value=\"'+esc(doc?doc.name:'')+'\" '+(doc?'readonly':'')+'></div><div class=\"field\"><label>Description (shown in Stable prompt index)</label><input id=\"skDesc\" value=\"'+esc(doc?doc.description:'')+'\"></div><div class=\"field\"><label>Markdown Body</label><textarea id=\"skBody\" rows=\"10\">'+esc(doc?doc.body:'')+'</textarea></div>','<button class=\"btn ghost\" onclick=\"closeModal()\">Cancel</button><button class=\"btn\" onclick=\"saveSkillModal()\">Save SKILL.md</button>');}",
    "async function saveSkillModal(){try{await api('/v1/skills',{method:'POST',body:JSON.stringify({name:$('skName').value.trim(),description:$('skDesc').value.trim(),body:$('skBody').value,provenance:'user'})});closeModal();toast('Skill saved');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function addRoutine(ev){ev.preventDefault();try{await api('/v1/routines',{method:'POST',body:JSON.stringify({bot_name:$('rBot').value,name:$('rName').value.trim(),prompt:$('rPrompt').value.trim(),interval_seconds:Number($('rInt').value)||900,read_only:$('rRo').checked})});toast('Routine saved');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function toggleRoutine(id,en){try{await api('/v1/routines/'+id+'/toggle',{method:'POST',body:JSON.stringify({enabled:en})});toast(en?'Routine resumed':'Routine paused');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function deleteRoutine(id){try{await api('/v1/routines/'+id,{method:'DELETE'});toast('Routine deleted');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function addConnector(ev){ev.preventDefault();try{await api('/v1/connectors',{method:'POST',body:JSON.stringify({name:$('cName').value.trim(),kind:'mcp_http',url:$('cUrl').value.trim(),auth_env:$('cEnv').value.trim(),allowed_host:'',default_effect:$('cEff').value,'enabled?':true})});toast('Connector mounted');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "function openEditConnector(name){const c=S.connectors.find(x=>x.name===name);if(!c)return;openModal('Edit Connector: '+c.name,'<div class=\"field\"><label>MCP Endpoint URL</label><input id=\"ecUrl\" value=\"'+esc(c.url)+'\" placeholder=\"https://your-env.connect.t3.codes/mcp\"></div><div class=\"field\"><label>Auth Token Env Var (optional when using OAuth)</label><input id=\"ecEnv\" value=\"'+esc(c.auth_env||'')+'\"></div><div class=\"field\"><label>Default Effect</label><select id=\"ecEff\"><option value=\"write_external\" '+(c.default_effect==='write_external'?'selected':'')+'>WriteExternal (Ask First)</option><option value=\"read\" '+(c.default_effect==='read'?'selected':'')+'>Read (Auto Allow)</option><option value=\"irreversible\" '+(c.default_effect==='irreversible'?'selected':'')+'>Irreversible</option></select></div>','<button class=\"btn ghost\" onclick=\"closeModal()\">Cancel</button><button class=\"btn\" onclick=\"saveEditConnector(\\''+esc(c.name)+'\\')\">Save URL</button>');}",
    "async function saveEditConnector(name){const c=S.connectors.find(x=>x.name===name);if(!c)return;try{await api('/v1/connectors',{method:'POST',body:JSON.stringify({name:c.name,kind:c.kind||'mcp_http',url:$('ecUrl').value.trim(),auth_env:$('ecEnv').value.trim(),allowed_host:'',default_effect:$('ecEff').value,'enabled?':true})});closeModal();toast('Updated '+name);await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function startOAuth(name){try{toast('Discovering OAuth for '+name+'…');const res=await api('/v1/connectors/'+encodeURIComponent(name)+'/oauth/start',{method:'POST',body:JSON.stringify({redirect_uri:location.origin+'/oauth/callback'})});location.href=res.authorize_url;}catch(e){toast('OAuth start failed: '+e.message);}}",
    "async function disconnectOAuth(name){try{await api('/v1/connectors/'+encodeURIComponent(name)+'/auth',{method:'DELETE'});toast('Disconnected '+name);await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function testConnector(name){try{toast('Testing '+name+'…');const r=await api('/v1/connectors/'+encodeURIComponent(name)+'/test',{method:'POST'});if(r['ok?']){openModal('Connector OK: '+name,'<div class=\"pill ok\" style=\"align-self:flex-start\">'+r.tool_count+' MCP tools discovered</div><pre>'+esc((r.tools||[]).join('\\n'))+'</pre>','<button class=\"btn\" onclick=\"closeModal()\">Done</button>');}else{toast('Test failed: '+(r.error||'unknown error'));}}catch(e){toast('Test error: '+e.message);}}",
    "async function toggleConnector(name,en){try{await api('/v1/connectors/'+encodeURIComponent(name)+'/toggle',{method:'POST',body:JSON.stringify({enabled:en})});toast(en?'Connector enabled':'Connector disabled');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function deleteConnector(name){try{await api('/v1/connectors/'+encodeURIComponent(name),{method:'DELETE'});toast('Connector deleted');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function addRule(ev){ev.preventDefault();try{await api('/v1/rules',{method:'POST',body:JSON.stringify({bot_name:$('pBot').value.trim()||'*',tool_pattern:$('pPat').value.trim(),decision:$('pDec').value,note:$('pNote').value.trim()})});toast('Rule added');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function deleteRule(id){try{await api('/v1/rules/'+id,{method:'DELETE'});toast('Rule deleted');await refreshAll();renderOps();}catch(e){toast(e.message);}}",
    "async function runSearch(ev){ev.preventDefault();const q=$('opsQ').value.trim();if(!q)return;S.searchHits=await api('/v1/sessions/search?q='+encodeURIComponent(q));renderOps();}",
    "function editActiveBot(){openBotModal(findBot(S.activeBot));}",
    "function applyPreset(p){const map={anthropic_sonnet:['anthropic','https://api.anthropic.com/v1/messages','ANTHROPIC_API_KEY','claude-sonnet-5-5','smart'],anthropic_opus:['anthropic','https://api.anthropic.com/v1/messages','ANTHROPIC_API_KEY','claude-opus-5-5','opus'],anthropic_haiku:['anthropic','https://api.anthropic.com/v1/messages','ANTHROPIC_API_KEY','claude-haiku-5-5','fast'],gemini_flash:['gemini','https://generativelanguage.googleapis.com/v1beta/models','GEMINI_API_KEY','gemini-2.5-flash','gemini_flash'],gemini_pro:['gemini','https://generativelanguage.googleapis.com/v1beta/models','GEMINI_API_KEY','gemini-2.5-pro','gemini_pro'],openai:['openai_compat','https://api.openai.com/v1/chat/completions','OPENAI_API_KEY','gpt-4.1','smart'],local:['openai_compat','http://127.0.0.1:11434/v1/chat/completions','','qwen2.5-coder','local']};const v=map[p];if(!v)return;$('bProv').value=v[0];$('bEp').value=v[1];$('bKey').value=v[2];$('bModel').value=v[3];$('bTier').value=v[4];}",
    "function openBotModal(b){openModal(b?'Edit Bot: '+b.name:'Create New Bot','<div class=\"row\"><div class=\"field\"><label>Name</label><input id=\"bName\" value=\"'+esc(b?b.name:'')+'\" placeholder=\"travel\"></div><div class=\"field\"><label>Role</label><input id=\"bRole\" value=\"'+esc(b?b.role:'')+'\" placeholder=\"Travel Planner\"></div></div><label style=\"font-size:12px;display:flex;align-items:center;gap:6px\"><input id=\"bPrim\" type=\"checkbox\" '+(b&&b['is_primary?']?'checked':'')+'> Primary Bot (Chief of Staff)</label><div class=\"field\"><label>Quick Provider Preset</label><div class=\"row\"><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'anthropic_sonnet\\')\">Claude Sonnet 5.5</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'anthropic_opus\\')\">Claude Opus 5.5</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'anthropic_haiku\\')\">Claude Haiku 5.5</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'gemini_flash\\')\">Gemini 2.5 Flash</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'gemini_pro\\')\">Gemini 2.5 Pro</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'openai\\')\">OpenAI</button><button type=\"button\" class=\"btn sm ghost\" onclick=\"applyPreset(\\'local\\')\">Local</button></div></div><div class=\"row\"><div class=\"field\"><label>Wire Protocol</label><select id=\"bProv\"><option value=\"anthropic\" '+(!b||b.provider==='anthropic'?'selected':'')+'>Anthropic Messages (cached)</option><option value=\"gemini\" '+(b&&b.provider==='gemini'?'selected':'')+'>Google Gemini (native)</option><option value=\"openai_compat\" '+(b&&b.provider==='openai_compat'?'selected':'')+'>OpenAI-compatible</option></select></div><div class=\"field\"><label>Model</label><input id=\"bModel\" value=\"'+esc(b?b.model:'claude-sonnet-5-5')+'\"></div><div class=\"field\"><label>Tier</label><select id=\"bTier\"><option value=\"fast\" '+(b&&b.model_tier==='fast'?'selected':'')+'>fast</option><option value=\"gemini_flash\" '+(b&&b.model_tier==='gemini_flash'?'selected':'')+'>gemini_flash</option><option value=\"gemini_pro\" '+(b&&b.model_tier==='gemini_pro'?'selected':'')+'>gemini_pro</option><option value=\"smart\" '+(!b||b.model_tier==='smart'?'selected':'')+'>smart</option><option value=\"opus\" '+(b&&b.model_tier==='opus'?'selected':'')+'>opus</option><option value=\"local\" '+(b&&b.model_tier==='local'?'selected':'')+'>local</option></select></div></div><div class=\"row\"><div class=\"field\"><label>Endpoint URL</label><input id=\"bEp\" value=\"'+esc(b?b.endpoint:'https://api.anthropic.com/v1/messages')+'\"></div><div class=\"field\"><label>API Key Secret / Env Name</label><input id=\"bKey\" value=\"'+esc(b?b.api_key_env:'ANTHROPIC_API_KEY')+'\"></div></div><div class=\"row\"><div class=\"field\"><label>Daily USD Cap</label><input id=\"bCap\" value=\"'+esc(b?b.daily_budget_usd:'5.00')+'\"></div><div class=\"field\"><label>Max Steps</label><input id=\"bSteps\" type=\"number\" value=\"'+esc(b?b.max_steps:10)+'\"></div><div class=\"field\"><label>Workspace</label><input id=\"bWs\" value=\"'+esc(b?b.workspace:'.')+'\"></div></div><div class=\"row\"><div class=\"field\"><label>Mounted Connectors (comma)</label><input id=\"bConns\" value=\"'+esc(b?(b.connectors||[]).join(', '):'')+'\"></div><div class=\"field\"><label>Read-Only Connector Locks (comma)</label><input id=\"bRoConns\" value=\"'+esc(b?(b.read_only_connectors||[]).join(', '):'')+'\"></div></div><div class=\"field\"><label>Allowed Local Programs (comma)</label><input id=\"bProgs\" value=\"'+esc(b?(b.allowed_programs||[]).join(', '):'')+'\"></div><div class=\"field\"><label>Persona &amp; Standing Instructions</label><textarea id=\"bPersona\" rows=\"4\">'+esc(b?b.persona:'')+'</textarea></div>','<button class=\"btn ghost\" onclick=\"closeModal()\">Cancel</button><button class=\"btn\" onclick=\"saveBotModal()\">Save Bot</button>');}",
    "async function saveBotModal(){const split=s=>s.split(',').map(x=>x.trim()).filter(Boolean);try{const saved=await api('/v1/bots',{method:'POST',body:JSON.stringify({name:$('bName').value.trim(),role:$('bRole').value.trim(),persona:$('bPersona').value.trim(),is_primary:$('bPrim').checked,model_tier:$('bTier').value,provider:$('bProv').value,endpoint:$('bEp').value.trim(),api_key_env:$('bKey').value.trim(),model:$('bModel').value.trim(),workspace:$('bWs').value.trim()||'.',allowed_programs:split($('bProgs').value),connectors:split($('bConns').value),read_only_connectors:split($('bRoConns').value),daily_budget_usd:$('bCap').value.trim()||'5.00',max_steps:Number($('bSteps').value)||10})});closeModal();S.activeBot=saved.name;toast('Saved bot '+saved.name);await refreshAll();}catch(e){toast(e.message);}}",
    "function openSettings(){const th=localStorage.getItem('motet_theme')||'auto';const tok=localStorage.getItem('motet_token')||'';const mcpUrl=location.origin+'/mcp';openModal('Motet Settings','<div class=\"field\"><label>API Bearer Token (if MOTET_API_TOKEN is set)</label><input id=\"sTok\" type=\"password\" value=\"'+esc(tok)+'\" placeholder=\"Optional on private exe.dev host\"></div><div class=\"field\"><label>Theme</label><select id=\"sTheme\"><option value=\"auto\" '+(th==='auto'?'selected':'')+'>System Auto</option><option value=\"dark\" '+(th==='dark'?'selected':'')+'>Dark</option><option value=\"light\" '+(th==='light'?'selected':'')+'>Light</option></select></div><div class=\"card\"><strong>Endpoints for Mac / iOS / T3 Code</strong><div>OpenAPI 3.1: <code>'+esc(location.origin)+'/openapi.json</code></div><div>MCP Server: <code>'+esc(mcpUrl)+'</code></div><div>Webhooks: <code>'+esc(location.origin)+'/webhooks/&lt;source&gt;</code></div></div>','<button class=\"btn ghost\" onclick=\"closeModal()\">Close</button><button class=\"btn\" onclick=\"saveSettings()\">Save</button>');}",
    "function saveSettings(){localStorage.setItem('motet_token',$('sTok').value.trim());localStorage.setItem('motet_theme',$('sTheme').value);applyTheme();closeModal();refreshAll();toast('Settings saved');}",
    "async function loadInbox(){S.inbox=await api('/v1/inbox?pending='+(S.inboxPending?'true':'false'));renderInbox();}",
    "async function refreshAll(){try{const h=await api('/v1/health');$('healthPill').textContent=h.bots+' bots · '+h.pending_approvals+' inbox';$('healthPill').className='pill '+(h.pending_approvals>0?'warn':'ok');const [bots,sessions,inbox,budgets,conns,connAuth,routines,skills,memory,rules,arts]=await Promise.all([api('/v1/bots'),api('/v1/sessions'),api('/v1/inbox?pending='+(S.inboxPending?'true':'false')),api('/v1/budget'),api('/v1/connectors'),api('/v1/connectors/auth'),api('/v1/routines'),api('/v1/skills'),api('/v1/memory'),api('/v1/rules'),api('/v1/artifacts')]);S.bots=bots;S.sessions=sessions;S.inbox=inbox;S.budgets=budgets;S.connectors=conns;S.connAuth=connAuth;S.routines=routines;S.skills=skills;S.memory=memory;S.rules=rules;S.artifacts=arts;if(!S.bots.find(b=>b.name===S.activeBot)&&S.bots.length)S.activeBot=S.bots[0].name;renderBots();renderSessions();renderInbox();renderBudgets();if(S.centerMode==='ops')renderOps();if(!S.sessionId&&!$('chatFeed').children.length)renderEmptyChat();}catch(e){$('healthPill').textContent='auth / offline';$('healthPill').className='pill bad';}}",
    "$('promptInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendAsk(e);}});",
    "$('promptInput').addEventListener('input',function(){this.style.height='auto';this.style.height=Math.min(160,this.scrollHeight)+'px';});",
    "$('globalSearch').addEventListener('keydown',async e=>{if(e.key==='Enter'){e.preventDefault();const q=e.target.value.trim();if(!q)return;setCenterMode('ops');setOpsTab('search');S.searchHits=await api('/v1/sessions/search?q='+encodeURIComponent(q));renderOps();}});",
    "document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('globalSearch').focus();}if(e.key==='Escape')closeModal();});",
    "applyTheme();refreshAll().then(()=>{const c=new URLSearchParams(location.search).get('connected');if(c){history.replaceState({},'','/');if(window.innerWidth<=980)setMob('ops');else setCenterMode('ops');setOpsTab('connectors');toast('Connected '+c+' via OAuth!');}});setInterval(refreshAll,15000);",
    "</script>"
  ].join("")
end

## Complete self-contained responsive HTML page.
fn app_html() : Text
  [
    "<!doctype html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">",
    "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">",
    "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">",
    "<meta name=\"theme-color\" content=\"#0c0f14\">",
    "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/icon.svg\">",
    "<link rel=\"apple-touch-icon\" href=\"/icon.svg\">",
    "<link rel=\"manifest\" href=\"/manifest.json\">",
    "<title>Motet — Living Bot Roster</title>",
    "<style>",
    ui_css(),
    "</style>",
    "</head>",
    "<body>",
    ui_markup(),
    ui_script(),
    "</body>",
    "</html>"
  ].join("")
end
